if(NOT DEFINED PS4_DEPS_ROOT)
  set(PS4_DEPS_ROOT "${PS4_SYSROOT}")
endif()

set(THREADS_PREFER_PTHREAD_FLAG ON)
find_package(Threads REQUIRED)
if(TARGET Threads::Threads)
  set_target_properties(Threads::Threads PROPERTIES INTERFACE_LINK_LIBRARIES "" INTERFACE_LINK_OPTIONS ""
                                                    INTERFACE_COMPILE_OPTIONS "")
endif()

if(NOT DEFINED PS4_DEPS_INCLUDE)
  set(PS4_DEPS_INCLUDE "${PS4_DEPS_ROOT}/include")
endif()

function(ps4_dep target)
  add_library(${target} INTERFACE IMPORTED GLOBAL)
  set(_incs "${PS4_DEPS_INCLUDE}")
  set(_libs "")
  foreach(_item IN LISTS ARGN)
    if(_item MATCHES "^inc:")
      string(SUBSTRING "${_item}" 4 -1 _dir)
      list(APPEND _incs "${PS4_DEPS_INCLUDE}/${_dir}")
    elseif(NOT PS4_SIM AND EXISTS "${PS4_DEPS_ROOT}/lib/${_item}")
      list(APPEND _libs "${PS4_DEPS_ROOT}/lib/${_item}")
    endif()
  endforeach()
  set_target_properties(${target} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_incs}")
  if(_libs)
    set_target_properties(${target} PROPERTIES INTERFACE_LINK_LIBRARIES "${_libs}")
  endif()
endfunction()

ps4_dep(ZLIB::ZLIB libz.a)
ps4_dep(Zstd::Zstd libzstd.a)
ps4_dep(PNG::PNG libpng16.a)
target_link_libraries(PNG::PNG INTERFACE ZLIB::ZLIB)
ps4_dep(JPEG::JPEG libjpeg.a)
ps4_dep(WebP::libwebp libwebp.a libsharpyuv.a)
ps4_dep(Freetype::Freetype inc:freetype2 libfreetype.a)
target_link_libraries(Freetype::Freetype INTERFACE PNG::PNG ZLIB::ZLIB)
ps4_dep(ps4::glslang libglslang.a libSPIRV.a libglslang-default-resource-limits.a libMachineIndependent.a libGenericCodeGen.a libOSDependent.a libglslang.a libMachineIndependent.a)

set(ZLIB_FOUND TRUE)
set(PNG_FOUND TRUE)
set(JPEG_FOUND TRUE)
set(Freetype_FOUND TRUE)
