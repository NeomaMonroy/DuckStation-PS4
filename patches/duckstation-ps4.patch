+std::u16string PS4ToUtf16(std::string_view text)
+{
+  std::u16string out;
+  for (size_t i = 0; i < text.size();)
+  {
+    const u8 c = static_cast<u8>(text[i]);
+    u32 cp;
+    size_t len;
+    if (c < 0x80)
+    {
+      cp = c;
+      len = 1;
+    }
+    else if ((c >> 5) == 0x6 && i + 1 < text.size())
+    {
+      cp = ((c & 0x1F) << 6) | (static_cast<u8>(text[i + 1]) & 0x3F);
+      len = 2;
+    }
+    else if ((c >> 4) == 0xE && i + 2 < text.size())
+    {
+      cp = ((c & 0x0F) << 12) | ((static_cast<u8>(text[i + 1]) & 0x3F) << 6) | (static_cast<u8>(text[i + 2]) & 0x3F);
+      len = 3;
+    }
+    else if ((c >> 3) == 0x1E && i + 3 < text.size())
+    {
+      cp = ((c & 0x07) << 18) | ((static_cast<u8>(text[i + 1]) & 0x3F) << 12) |
+           ((static_cast<u8>(text[i + 2]) & 0x3F) << 6) | (static_cast<u8>(text[i + 3]) & 0x3F);
+      len = 4;
+    }
+    else
+    {
+      cp = '?';
+      len = 1;
+    }
+    if (cp >= 0x10000)
+    {
+      cp -= 0x10000;
+      out.push_back(static_cast<char16_t>(0xD800 + (cp >> 10)));
+      out.push_back(static_cast<char16_t>(0xDC00 + (cp & 0x3FF)));
+    }
+    else
+    {
+      out.push_back(static_cast<char16_t>(cp));
+    }
+    i += len;
+  }
+  return out;
+}
+
+std::string PS4ToUtf8(const char16_t* text)
+{
+  std::string out;
+  for (size_t i = 0; text[i] != 0; i++)
+  {
+    u32 cp = text[i];
+    if (cp >= 0xD800 && cp < 0xDC00 && text[i + 1] >= 0xDC00 && text[i + 1] < 0xE000)
+    {
+      cp = 0x10000 + ((cp - 0xD800) << 10) + (text[i + 1] - 0xDC00);
+      i++;
+    }
+    if (cp < 0x80)
+    {
+      out += static_cast<char>(cp);
+    }
+    else if (cp < 0x800)
+    {
+      out += static_cast<char>(0xC0 | (cp >> 6));
+      out += static_cast<char>(0x80 | (cp & 0x3F));
+    }
+    else if (cp < 0x10000)
+    {
+      out += static_cast<char>(0xE0 | (cp >> 12));
+      out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+      out += static_cast<char>(0x80 | (cp & 0x3F));
+    }
+    else
+    {
+      out += static_cast<char>(0xF0 | (cp >> 18));
+      out += static_cast<char>(0x80 | ((cp >> 12) & 0x3F));
+      out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+      out += static_cast<char>(0x80 | (cp & 0x3F));
+    }
+  }
+  return out;
+}
