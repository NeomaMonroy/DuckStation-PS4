+#ifdef __PS4__
+void GPUDevice::PS4SavePipelineCache()
+{
+  static size_t s_saved_size = 0;
+  if (s_pipeline_cache_path.empty())
+    return;
+
+  DynamicHeapArray<u8> data;
+  if (!GetPipelineCacheData(&data) || data.size() == s_saved_size)
+    return;
+
+  s_saved_size = data.size();
+  std::vector<u8> copy(data.data(), data.data() + data.size());
+  std::thread([path = s_pipeline_cache_path, copy = std::move(copy)]() {
+    const std::string tmp = path + ".tmp";
+    if (FileSystem::WriteBinaryFile(tmp.c_str(), copy.data(), copy.size()))
+      FileSystem::RenamePath(tmp.c_str(), path.c_str());
+  }).detach();
+}
+#endif
