diff --git a/src/duckstation-nogui/ps4_nogui_platform.cpp b/src/duckstation-nogui/ps4_nogui_platform.cpp
new file mode 100644
index 00000000..a2a8ea92
--- /dev/null
+++ b/src/duckstation-nogui/ps4_nogui_platform.cpp
@@ -0,0 +1,167 @@
+#include "nogui_host.h"
+#include "nogui_platform.h"
+
+#include "common/log.h"
+#include "common/ps4_host.h"
+#include "common/settings_interface.h"
+
+#include "core/host.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <mutex>
+
+Log_SetChannel(PS4NoGUIPlatform);
+
+namespace {
+
+class PS4NoGUIPlatform final : public NoGUIPlatform
+{
+public:
+  PS4NoGUIPlatform() = default;
+  ~PS4NoGUIPlatform() override = default;
+
+  void ReportError(const std::string_view& title, const std::string_view& message) override
+  {
+    Log_ErrorFmt("{}: {}", title, message);
+    std::string text = fmt::format("DuckStation: {}\n{}", title, message.substr(0, 400));
+    ps4_host_notify(text.c_str());
+  }
+
+  bool ConfirmMessage(const std::string_view& title, const std::string_view& message) override
+  {
+    Log_WarningFmt("{}: {}", title, message);
+    return true;
+  }
+
+  void SetDefaultConfig(SettingsInterface& si) override;
+
+  bool CreatePlatformWindow(std::string title) override { return true; }
+  bool HasPlatformWindow() const override { return true; }
+  void DestroyPlatformWindow() override {}
+
+  std::optional<WindowInfo> GetPlatformWindowInfo() override
+  {
+    WindowInfo wi;
+    wi.type = WindowInfo::Type::PS4;
+    wi.surface_width = 1920;
+    wi.surface_height = 1080;
+    wi.surface_scale = 1.0f;
+    wi.surface_refresh_rate = 60.0f;
+    wi.surface_format = GPUTexture::Format::RGBA8;
+    return wi;
+  }
+
+  void SetPlatformWindowTitle(std::string title) override {}
+
+  std::optional<u32> ConvertHostKeyboardStringToCode(const std::string_view& str) override { return std::nullopt; }
+  std::optional<std::string> ConvertHostKeyboardCodeToString(u32 code) override { return std::nullopt; }
+
+  void RunMessageLoop() override
+  {
+    std::unique_lock lock(m_mutex);
+    while (m_running.load(std::memory_order_acquire))
+    {
+      m_cv.wait_for(lock, std::chrono::milliseconds(50),
+                    [this]() { return !m_queue.empty() || !m_running.load(std::memory_order_acquire); });
+      while (!m_queue.empty())
+      {
+        std::function<void()> func = std::move(m_queue.front());
+        m_queue.pop_front();
+        lock.unlock();
+        func();
+        lock.lock();
+      }
+    }
+  }
+
+  void ExecuteInMessageLoop(std::function<void()> func) override
+  {
+    {
+      std::unique_lock lock(m_mutex);
+      m_queue.push_back(std::move(func));
+    }
+    m_cv.notify_one();
+  }
+
+  void QuitMessageLoop() override
+  {
+    m_running.store(false, std::memory_order_release);
+    m_cv.notify_one();
+  }
+
+  void SetFullscreen(bool enabled) override {}
+  bool RequestRenderWindowSize(s32 new_window_width, s32 new_window_height) override { return false; }
+  bool OpenURL(const std::string_view& url) override { return false; }
+  bool CopyTextToClipboard(const std::string_view& text) override { return false; }
+
+private:
+  std::mutex m_mutex;
+  std::condition_variable m_cv;
+  std::deque<std::function<void()>> m_queue;
+  std::atomic_bool m_running{true};
+};
+
+void PS4NoGUIPlatform::SetDefaultConfig(SettingsInterface& si)
+{
+  si.SetStringValue("CPU", "ExecutionMode", "Recompiler");
+  si.SetStringValue("CPU", "FastmemMode", "LUT");
+
+  si.SetStringValue("GPU", "Renderer", "Vulkan");
+  si.SetIntValue("GPU", "ResolutionScale", 3);
+  si.SetBoolValue("GPU", "UseThread", true);
+  si.SetBoolValue("GPU", "ThreadedPresentation", true);
+  si.SetBoolValue("GPU", "PGXPEnable", true);
+  si.SetBoolValue("GPU", "PGXPCulling", true);
+  si.SetBoolValue("GPU", "PGXPTextureCorrection", true);
+
+  si.SetBoolValue("Display", "VSync", true);
+  si.SetBoolValue("Main", "SyncToHostRefreshRate", true);
+  si.SetBoolValue("Main", "PauseOnFocusLoss", false);
+  si.SetBoolValue("Main", "ConfirmPowerOff", false);
+  si.SetBoolValue("Main", "SaveStateOnExit", true);
+
+  si.SetBoolValue("Logging", "LogToFile", true);
+
+  si.ClearSection("InputSources");
+  si.SetBoolValue("InputSources", "PS4", true);
+
+  const std::string data_dir = ps4_host_data_dir();
+  si.SetStringValue("BIOS", "SearchDirectory", (data_dir + "/bios").c_str());
+  si.ClearSection("GameList");
+  si.AddToStringList("GameList", "RecursivePaths", (data_dir + "/games").c_str());
+  si.AddToStringList("GameList", "RecursivePaths", "/mnt/usb0/PS1");
+  si.AddToStringList("GameList", "RecursivePaths", "/mnt/usb1/PS1");
+
+  static constexpr const char* buttons[][2] = {
+    {"Up", "DPadUp"},     {"Right", "DPadRight"}, {"Down", "DPadDown"},     {"Left", "DPadLeft"},
+    {"Triangle", "Triangle"}, {"Circle", "Circle"}, {"Cross", "Cross"},     {"Square", "Square"},
+    {"Select", "TouchPad"}, {"Start", "Options"},  {"L1", "L1"},             {"R1", "R1"},
+    {"L2", "L2"},         {"R2", "R2"},           {"L3", "L3"},             {"R3", "R3"},
+    {"LLeft", "-LeftX"},  {"LRight", "+LeftX"},   {"LUp", "-LeftY"},        {"LDown", "+LeftY"},
+    {"RLeft", "-RightX"}, {"RRight", "+RightX"},  {"RUp", "-RightY"},       {"RDown", "+RightY"},
+    {"LargeMotor", "LargeMotor"}, {"SmallMotor", "SmallMotor"},
+  };
+
+  for (u32 port = 0; port < 2; port++)
+  {
+    const std::string section = fmt::format("Pad{}", port + 1);
+    si.ClearSection(section.c_str());
+    si.SetStringValue(section.c_str(), "Type", "AnalogController");
+    for (const auto& [name, binding] : buttons)
+      si.SetStringValue(section.c_str(), name, fmt::format("P{}/{}", port, binding).c_str());
+  }
+
+  si.ClearSection("Hotkeys");
+  si.SetStringValue("Hotkeys", "OpenPauseMenu", "P0/L3 & P0/R3");
+}
+
+}
+
+std::unique_ptr<NoGUIPlatform> NoGUIPlatform::CreatePS4Platform()
+{
+  return std::make_unique<PS4NoGUIPlatform>();
+}
