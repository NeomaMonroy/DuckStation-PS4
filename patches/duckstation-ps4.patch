+void FullscreenUI::DrawGameCarousel(const ImVec2& heading_size)
+{
+  static s32 s_index = 0;
+  static float s_scroll = 0.0f;
+  static double s_last_time = 0.0;
+
+  ImGuiIO& io = ImGui::GetIO();
+  const ImVec2 window_pos(0.0f, heading_size.y);
+  const ImVec2 window_size(io.DisplaySize.x, io.DisplaySize.y - heading_size.y - LayoutScale(LAYOUT_FOOTER_HEIGHT));
+  if (!BeginFullscreenWindow(window_pos, window_size, "game_carousel", UIBackgroundColor))
+  {
+    EndFullscreenWindow();
+    return;
+  }
+
+  ResetFocusHere();
+  const bool focused = ImGui::IsWindowFocused();
+  if (focused && WantsToCloseMenu())
+    ReturnToPreviousWindow();
+
+  const s32 count = static_cast<s32>(s_game_list_sorted_entries.size());
+  ImDrawList* dl = ImGui::GetWindowDrawList();
+  const ImVec2 wmin = ImGui::GetWindowPos();
+  const ImVec2 wmax = wmin + ImGui::GetWindowSize();
+  const float ww = wmax.x - wmin.x;
+  const float wh = wmax.y - wmin.y;
+
+  if (count == 0)
+  {
+    ImGui::PushFont(g_large_font);
+    const char* text = FSUI_CSTR("No games found.");
+    const ImVec2 ts = g_large_font->CalcTextSizeA(g_large_font->FontSize, FLT_MAX, 0.0f, text);
+    dl->AddText(g_large_font, g_large_font->FontSize, ImVec2(wmin.x + (ww - ts.x) * 0.5f, wmin.y + (wh - ts.y) * 0.5f),
+                ImGui::GetColorU32(UIPrimaryTextColor), text);
+    ImGui::PopFont();
+    EndFullscreenWindow();
+    return;
+  }
+
+  s_index = std::clamp(s_index, 0, count - 1);
+  if (focused)
+  {
+    s32 move = 0;
+    if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadLeft, true) || ImGui::IsKeyPressed(ImGuiKey_GamepadLStickLeft, true) ||
+        ImGui::IsKeyPressed(ImGuiKey_LeftArrow, true))
+      move = -1;
+    else if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadRight, true) ||
+             ImGui::IsKeyPressed(ImGuiKey_GamepadLStickRight, true) || ImGui::IsKeyPressed(ImGuiKey_RightArrow, true))
+      move = 1;
+    else if (ImGui::IsKeyPressed(ImGuiKey_GamepadL1, true) || ImGui::IsKeyPressed(ImGuiKey_PageUp, true))
+      move = -5;
+    else if (ImGui::IsKeyPressed(ImGuiKey_GamepadR1, true) || ImGui::IsKeyPressed(ImGuiKey_PageDown, true))
+      move = 5;
+    else if (ImGui::IsKeyPressed(ImGuiKey_Home, false))
+      move = -count;
+    else if (ImGui::IsKeyPressed(ImGuiKey_End, false))
+      move = count;
+    s_index = std::clamp(s_index + move, 0, count - 1);
+
+    const GameList::Entry* selected = s_game_list_sorted_entries[s_index];
+    if (ImGui::IsKeyPressed(ImGuiKey_NavGamepadActivate, false) || ImGui::IsKeyPressed(ImGuiKey_Enter, false))
+      HandleGameListActivate(selected);
+    else if (ImGui::IsKeyPressed(ImGuiKey_NavGamepadMenu, false) || ImGui::IsKeyPressed(ImGuiKey_F3, false))
+      HandleGameListOptions(selected);
+  }
+
+  const double now = ImGui::GetTime();
+  const float dt = (s_last_time > 0.0) ? static_cast<float>(std::min(now - s_last_time, 0.1)) : 1.0f;
+  s_last_time = now;
+  s_scroll += (static_cast<float>(s_index) - s_scroll) * std::min(1.0f, dt * 12.0f);
+  if (std::abs(static_cast<float>(s_index) - s_scroll) < 0.001f)
+    s_scroll = static_cast<float>(s_index);
+
+  const GameList::Entry* current = s_game_list_sorted_entries[s_index];
+
+  GPUTexture* const bg_tex = GetGameListCover(current);
+  if (bg_tex)
+  {
+    const float tw = static_cast<float>(bg_tex->GetWidth());
+    const float th = static_cast<float>(bg_tex->GetHeight());
+    const float scale = std::max(ww / tw, wh / th) * 1.15f;
+    const ImVec2 bsize(tw * scale, th * scale);
+    const ImVec2 bpos(wmin.x + (ww - bsize.x) * 0.5f, wmin.y + (wh - bsize.y) * 0.5f);
+    dl->AddImage(bg_tex, bpos, bpos + bsize, ImVec2(0.0f, 0.0f), ImVec2(1.0f, 1.0f), IM_COL32(255, 255, 255, 46));
+  }
+  const ImU32 bg_solid = ImGui::GetColorU32(UIBackgroundColor);
+  const ImU32 bg_clear = ImGui::GetColorU32(ImVec4(UIBackgroundColor.x, UIBackgroundColor.y, UIBackgroundColor.z, 0.0f));
+  dl->AddRectFilledMultiColor(wmin, ImVec2(wmax.x, wmin.y + wh * 0.25f), bg_solid, bg_solid, bg_clear, bg_clear);
+  dl->AddRectFilledMultiColor(ImVec2(wmin.x, wmin.y + wh * 0.55f), wmax, bg_clear, bg_clear, bg_solid, bg_solid);
+
+  const float box = std::min(wh * 0.50f, ww * 0.30f);
+  const float center_x = wmin.x + ww * 0.5f;
+  const float base_y = wmin.y + wh * 0.08f + box;
+  const float spacing = box * 0.78f;
+  const float pulse = 0.55f + 0.45f * static_cast<float>(std::sin(now * 3.0));
+
+  struct Slot
+  {
+    s32 index;
+    float dist;
+  };
+  std::vector<Slot> slots;
+  const s32 first = std::max(0, static_cast<s32>(std::floor(s_scroll)) - 5);
+  const s32 last = std::min(count - 1, static_cast<s32>(std::ceil(s_scroll)) + 5);
+  for (s32 i = first; i <= last; i++)
+    slots.push_back({i, static_cast<float>(i) - s_scroll});
+  std::sort(slots.begin(), slots.end(),
+            [](const Slot& a, const Slot& b) { return std::abs(a.dist) > std::abs(b.dist); });
+
+  for (const Slot& slot : slots)
+  {
+    const float ad = std::abs(slot.dist);
+    const float scale = 1.0f - std::min(ad, 3.0f) * 0.17f;
+    const float alpha = std::clamp(1.0f - ad * 0.22f, 0.0f, 1.0f);
+    const float side = (slot.dist < 0.0f) ? -1.0f : 1.0f;
+    const float offset = (ad <= 1.0f) ? slot.dist * spacing : side * (spacing + (ad - 1.0f) * spacing * 0.62f);
+    const float size = box * scale;
+    const ImVec2 cmin(center_x + offset - size * 0.5f, base_y - size);
+    const ImVec2 cmax(cmin.x + size, base_y);
+    if (cmax.x < wmin.x || cmin.x > wmax.x)
+      continue;
+
+    GPUTexture* const tex = GetGameListCover(s_game_list_sorted_entries[slot.index]);
+    if (!tex)
+      continue;
+    const ImRect img = CenterImage(ImRect(cmin, cmax), ImVec2(static_cast<float>(tex->GetWidth()),
+                                                              static_cast<float>(tex->GetHeight())));
+    const ImRect fitted(ImVec2(img.Min.x, cmax.y - img.GetHeight()), ImVec2(img.Max.x, cmax.y));
+    const u8 a8 = static_cast<u8>(alpha * 255.0f);
+    const float rounding = LayoutScale(6.0f);
+
+    const float shadow = LayoutScale(14.0f) * scale;
+    dl->AddRectFilled(fitted.Min + ImVec2(shadow * 0.4f, shadow), fitted.Max + ImVec2(shadow * 0.4f, shadow),
+                      IM_COL32(0, 0, 0, static_cast<u8>(110 * alpha)), rounding);
+
+    const float refl_h = fitted.GetHeight() * 0.35f;
+    const ImVec2 rmin(fitted.Min.x, fitted.Max.y + LayoutScale(4.0f));
+    const ImVec2 rmax(fitted.Max.x, rmin.y + refl_h);
+    dl->AddImage(tex, rmin, rmax, ImVec2(0.0f, 1.0f), ImVec2(1.0f, 0.65f),
+                 IM_COL32(255, 255, 255, static_cast<u8>(70 * alpha)));
+    dl->AddRectFilledMultiColor(rmin, rmax, bg_clear, bg_clear, bg_solid, bg_solid);
+
+    dl->AddImageRounded(tex, fitted.Min, fitted.Max, ImVec2(0.0f, 0.0f), ImVec2(1.0f, 1.0f),
+                        IM_COL32(255, 255, 255, a8), rounding);
+    if (ad > 0.5f)
+      dl->AddRectFilled(fitted.Min, fitted.Max, IM_COL32(0, 0, 0, static_cast<u8>(std::min(ad, 3.0f) * 40.0f)),
+                        rounding);
+
+    if (slot.index == s_index && ad < 0.5f)
+    {
+      const ImVec4 glow = UIPrimaryColor;
+      for (int g = 3; g >= 1; g--)
+      {
+        const float grow = LayoutScale(3.0f) * static_cast<float>(g);
+        dl->AddRect(fitted.Min - ImVec2(grow, grow), fitted.Max + ImVec2(grow, grow),
+                    ImGui::GetColorU32(ImVec4(glow.x, glow.y, glow.z, pulse * 0.28f / static_cast<float>(g))),
+                    rounding + grow, 0, LayoutScale(3.0f));
+      }
+      dl->AddRect(fitted.Min, fitted.Max, ImGui::GetColorU32(ImVec4(glow.x, glow.y, glow.z, 0.6f + 0.4f * pulse)),
+                  rounding, 0, LayoutScale(3.0f));
+    }
+  }
+
+  const float text_y = base_y + box * 0.35f + LayoutScale(18.0f);
+  const ImU32 text_col = ImGui::GetColorU32(UIPrimaryTextColor);
+  const ImU32 dim_col = ImGui::GetColorU32(ImVec4(UIPrimaryTextColor.x, UIPrimaryTextColor.y, UIPrimaryTextColor.z, 0.65f));
+  auto centered_text = [&](ImFont* font, float y, std::string_view text, ImU32 col) {
+    const ImVec2 ts = font->CalcTextSizeA(font->FontSize, FLT_MAX, 0.0f, text.data(), text.data() + text.size());
+    const float x = std::max(wmin.x + LayoutScale(20.0f), center_x - ts.x * 0.5f);
+    dl->AddText(font, font->FontSize, ImVec2(x + 2.0f, y + 2.0f), IM_COL32(0, 0, 0, 160), text.data(),
+                text.data() + text.size());
+    dl->AddText(font, font->FontSize, ImVec2(x, y), col, text.data(), text.data() + text.size());
+    return ts.y;
+  };
+
+  float y = text_y;
+  y += centered_text(g_large_font, y, current->title, text_col) + LayoutScale(6.0f);
+
+  SmallString info;
+  if (!current->serial.empty())
+    info.append(current->serial);
+  if (current->region != DiscRegion::Other && current->region != DiscRegion::NonPS1)
+    info.append_format("{}{}", info.empty() ? "" : "   \xe2\x80\xa2   ", Settings::GetDiscRegionDisplayName(current->region));
+  char date[64];
+  if (current->GetReleaseDateString(date, sizeof(date)) > 0)
+    info.append_format("{}{}", info.empty() ? "" : "   \xe2\x80\xa2   ", date);
+  if (!current->genre.empty())
+    info.append_format("{}{}", info.empty() ? "" : "   \xe2\x80\xa2   ", current->genre);
+  if (!info.empty())
+    y += centered_text(g_medium_font, y, info.view(), dim_col) + LayoutScale(4.0f);
+
+  if (current->total_played_time > 0)
+  {
+    const TinyString played = GameList::FormatTimespan(current->total_played_time, true);
+    centered_text(g_medium_font, y, SmallString::from_format(FSUI_FSTR("All Time: {}"), played.view()).view(),
+                  dim_col);
+  }
+
+  const SmallString counter = SmallString::from_format("{} / {}", s_index + 1, count);
+  const ImVec2 cs = g_medium_font->CalcTextSizeA(g_medium_font->FontSize, FLT_MAX, 0.0f, counter.c_str(), counter.end_ptr());
+  dl->AddText(g_medium_font, g_medium_font->FontSize,
+              ImVec2(wmax.x - cs.x - LayoutScale(24.0f), wmax.y - cs.y - LayoutScale(14.0f)), dim_col,
+              counter.c_str(), counter.end_ptr());
+
+  const float bar_w = ww * 0.40f;
+  const float bar_x = center_x - bar_w * 0.5f;
+  const float bar_y = wmax.y - LayoutScale(22.0f);
+  dl->AddRectFilled(ImVec2(bar_x, bar_y), ImVec2(bar_x + bar_w, bar_y + LayoutScale(4.0f)), IM_COL32(255, 255, 255, 40),
+                    LayoutScale(2.0f));
+  const float frac = (count > 1) ? (s_scroll / static_cast<float>(count - 1)) : 1.0f;
+  const float knob_w = std::max(bar_w / static_cast<float>(count), LayoutScale(24.0f));
+  const float knob_x = bar_x + (bar_w - knob_w) * frac;
+  dl->AddRectFilled(ImVec2(knob_x, bar_y), ImVec2(knob_x + knob_w, bar_y + LayoutScale(4.0f)),
+                    ImGui::GetColorU32(UIPrimaryColor), LayoutScale(2.0f));
+
+  EndFullscreenWindow();
+}
