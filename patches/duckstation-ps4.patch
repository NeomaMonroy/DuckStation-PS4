+namespace {
+std::mutex s_ps4_translation_mutex;
+std::unordered_map<std::string, std::string> s_ps4_translations;
+
+void PS4LoadTranslations(const std::string& code)
+{
+  s_ps4_translations.clear();
+  if (code.empty() || code == "en")
+    return;
+
+  const std::optional<std::string> data =
+    Host::ReadResourceFileToString(fmt::format("translations/{}.tsv", code).c_str(), false);
+  if (!data.has_value())
+  {
+    Log_ErrorPrintf("No translation file for '%s'", code.c_str());
+    return;
+  }
+
+  const std::string& text = data.value();
+  size_t pos = 0;
+  while (pos < text.size())
+  {
+    size_t end = text.find('\x1e', pos);
+    if (end == std::string::npos)
+      end = text.size();
+    const size_t a = text.find('\x1f', pos);
+    const size_t b = (a == std::string::npos || a >= end) ? std::string::npos : text.find('\x1f', a + 1);
+    if (a != std::string::npos && a < end && b != std::string::npos && b < end)
+    {
+      std::string key = text.substr(pos, a - pos);
+      key += '\x04';
+      key.append(text, a + 1, b - a - 1);
+      s_ps4_translations[std::move(key)] = text.substr(b + 1, end - b - 1);
+    }
+    pos = end + 1;
+  }
+  Log_InfoPrintf("Loaded %zu strings for language '%s'", s_ps4_translations.size(), code.c_str());
+}
+}
+
+static void PS4ApplyLanguage(const std::string& code)
+{
+  std::unique_lock lock(s_ps4_translation_mutex);
+  PS4LoadTranslations(code);
+}
