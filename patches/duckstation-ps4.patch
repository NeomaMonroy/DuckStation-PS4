diff --git a/src/util/ps4_audio_stream.cpp b/src/util/ps4_audio_stream.cpp
new file mode 100644
index 00000000..b5802f12
--- /dev/null
+++ b/src/util/ps4_audio_stream.cpp
@@ -0,0 +1,163 @@
+#include "audio_stream.h"
+
+#include "common/log.h"
+#include "common/threading.h"
+
+#include <orbis/AudioOut.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+Log_SetChannel(PS4AudioStream);
+
+namespace {
+
+class PS4AudioStream final : public AudioStream
+{
+public:
+  PS4AudioStream(u32 sample_rate, u32 channels, u32 buffer_ms, AudioStretchMode stretch)
+    : AudioStream(sample_rate, channels, buffer_ms, stretch)
+  {
+  }
+
+  ~PS4AudioStream() override
+  {
+    m_running.store(false, std::memory_order_release);
+    if (m_thread.joinable())
+      m_thread.join();
+    if (m_port >= 0)
+      sceAudioOutClose(m_port);
+  }
+
+  void SetPaused(bool paused) override { m_paused.store(paused, std::memory_order_release); }
+
+  void SetOutputVolume(u32 volume) override
+  {
+    m_volume = volume;
+    m_thread_volume.store(volume, std::memory_order_release);
+  }
+
+  bool Initialize()
+  {
+    sceAudioOutInit();
+    m_port = sceAudioOutOpen(0xFF, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, OUTPUT_FRAMES, OUTPUT_RATE,
+                             ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+    if (m_port < 0)
+    {
+      Log_ErrorFmt("sceAudioOutOpen failed: {:08X}", static_cast<u32>(m_port));
+      return false;
+    }
+
+    m_thread_volume.store(m_volume, std::memory_order_release);
+    BaseInitialize();
+    m_running.store(true, std::memory_order_release);
+    m_thread = std::thread(&PS4AudioStream::AudioThread, this);
+    return true;
+  }
+
+private:
+  static constexpr u32 OUTPUT_FRAMES = 256;
+  static constexpr u32 OUTPUT_RATE = 48000;
+
+  void AudioThread()
+  {
+    Threading::SetNameOfCurrentThread("Audio Output");
+
+    const u32 ch = m_channels;
+    const double step = static_cast<double>(m_sample_rate) / static_cast<double>(OUTPUT_RATE);
+    const bool resample = (m_sample_rate != OUTPUT_RATE);
+    const u32 max_input = static_cast<u32>(OUTPUT_FRAMES * step) + 4;
+
+    alignas(64) s16 out[2][OUTPUT_FRAMES * 2];
+    std::vector<s16> in((max_input + 4) * ch);
+    u32 in_frames = 0;
+    double pos = 0.0;
+    u32 buffer = 0;
+
+    while (m_running.load(std::memory_order_acquire))
+    {
+      s16* dst = out[buffer];
+      buffer ^= 1;
+
+      if (m_paused.load(std::memory_order_acquire))
+      {
+        std::memset(dst, 0, sizeof(out[0]));
+      }
+      else if (!resample)
+      {
+        if (ch == 2)
+        {
+          ReadFrames(dst, OUTPUT_FRAMES);
+        }
+        else
+        {
+          ReadFrames(in.data(), OUTPUT_FRAMES);
+          for (u32 i = 0; i < OUTPUT_FRAMES; i++)
+            dst[i * 2] = dst[i * 2 + 1] = in[i];
+        }
+      }
+      else
+      {
+        const u32 needed = static_cast<u32>(pos + OUTPUT_FRAMES * step) + 2;
+        if (in_frames < needed)
+        {
+          ReadFrames(&in[in_frames * ch], needed - in_frames);
+          in_frames = needed;
+        }
+
+        for (u32 i = 0; i < OUTPUT_FRAMES; i++)
+        {
+          const u32 idx = static_cast<u32>(pos);
+          const s32 frac = static_cast<s32>((pos - idx) * 65536.0);
+          const s16* a = &in[idx * ch];
+          const s16* b = &in[(idx + 1) * ch];
+          const s32 l = a[0] + (((b[0] - a[0]) * frac) >> 16);
+          const s32 r = (ch > 1) ? (a[1] + (((b[1] - a[1]) * frac) >> 16)) : l;
+          dst[i * 2] = static_cast<s16>(l);
+          dst[i * 2 + 1] = static_cast<s16>(r);
+          pos += step;
+        }
+
+        const u32 consumed = std::min(static_cast<u32>(pos), in_frames);
+        if (consumed > 0)
+        {
+          std::memmove(in.data(), &in[consumed * ch], (in_frames - consumed) * ch * sizeof(s16));
+          in_frames -= consumed;
+          pos -= consumed;
+        }
+      }
+
+      const u32 volume = m_thread_volume.load(std::memory_order_acquire);
+      if (volume < 100)
+      {
+        const s32 scale = static_cast<s32>(volume * 65536 / 100);
+        for (u32 i = 0; i < OUTPUT_FRAMES * 2; i++)
+          dst[i] = static_cast<s16>((dst[i] * scale) >> 16);
+      }
+
+      sceAudioOutOutput(m_port, dst);
+    }
+
+    sceAudioOutOutput(m_port, nullptr);
+  }
+
+  s32 m_port = -1;
+  std::thread m_thread;
+  std::atomic_bool m_running{false};
+  std::atomic_bool m_paused{false};
+  std::atomic<u32> m_thread_volume{100};
+};
+
+}
+
+std::unique_ptr<AudioStream> AudioStream::CreatePS4AudioStream(u32 sample_rate, u32 channels, u32 buffer_ms,
+                                                               u32 latency_ms, AudioStretchMode stretch)
+{
+  std::unique_ptr<PS4AudioStream> stream = std::make_unique<PS4AudioStream>(sample_rate, channels, buffer_ms, stretch);
+  if (!stream->Initialize())
+    stream.reset();
+  return stream;
+}
diff --git a/src/util/ps4_glslang.cpp b/src/util/ps4_glslang.cpp
new file mode 100644
index 00000000..15b29adf
--- /dev/null
+++ b/src/util/ps4_glslang.cpp
@@ -0,0 +1,69 @@
+#include "ps4_glslang.h"
+
+#include <glslang/Public/ResourceLimits.h>
+#include <glslang/Public/ShaderLang.h>
+#include <glslang/SPIRV/GlslangToSpv.h>
+
+#include <memory>
+#include <mutex>
+
+static std::once_flag s_glslang_once;
+
+bool PS4GLSLToSPIRV(u32 stage, std::string_view source, const char* entry_point, std::vector<u32>* spirv,
+                    std::string* errors)
+{
+  static constexpr EShLanguage stages[] = {EShLangVertex, EShLangFragment, EShLangGeometry, EShLangCompute};
+  if (stage >= std::size(stages))
+  {
+    *errors = "unknown shader stage";
+    return false;
+  }
+
+  std::call_once(s_glslang_once, []() { glslang::InitializeProcess(); });
+
+  const EShLanguage lang = stages[stage];
+  glslang::TShader shader(lang);
+  const char* text = source.data();
+  const int length = static_cast<int>(source.length());
+  const char* name = "source";
+  shader.setStringsWithLengthsAndNames(&text, &length, &name, 1);
+  shader.setEntryPoint("main");
+  if (entry_point && entry_point[0] && std::string_view(entry_point) != "main")
+    shader.setSourceEntryPoint(entry_point);
+  shader.setEnvInput(glslang::EShSourceGlsl, lang, glslang::EShClientVulkan, 100);
+  shader.setEnvClient(glslang::EShClientVulkan, glslang::EShTargetVulkan_1_0);
+  shader.setEnvTarget(glslang::EShTargetSpv, glslang::EShTargetSpv_1_0);
+
+  const EShMessages messages = static_cast<EShMessages>(EShMsgSpvRules | EShMsgVulkanRules);
+  if (!shader.parse(GetDefaultResources(), 110, ENoProfile, false, false, messages))
+  {
+    *errors = shader.getInfoLog();
+    *errors += shader.getInfoDebugLog();
+    return false;
+  }
+
+  glslang::TProgram program;
+  program.addShader(&shader);
+  if (!program.link(messages))
+  {
+    *errors = program.getInfoLog();
+    *errors += program.getInfoDebugLog();
+    return false;
+  }
+
+  glslang::SpvOptions options;
+  options.generateDebugInfo = false;
+  options.disableOptimizer = true;
+  options.optimizeSize = false;
+  options.validate = false;
+  spv::SpvBuildLogger logger;
+  spirv->clear();
+  glslang::GlslangToSpv(*program.getIntermediate(lang), *spirv, &logger, &options);
+  if (spirv->empty())
+  {
+    *errors = logger.getAllMessages();
+    return false;
+  }
+
+  return true;
+}
