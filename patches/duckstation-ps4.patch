@@ -0,0 +1,443 @@
+#include "ps4_input_source.h"
+#include "input_manager.h"
+
+#include "common/bitutils.h"
+#include "common/log.h"
+#include "common/string_util.h"
+#include "common/timer.h"
+
+#include "core/host.h"
+
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+#include <algorithm>
+#include <unistd.h>
+
+Log_SetChannel(PS4InputSource);
+
+static constexpr u32 PAD_INTERCEPTED = 0x80000000u;
+
+struct PS4Button
+{
+  const char* name;
+  u32 mask;
+  GenericInputBinding generic;
+};
+
+static constexpr u32 TOUCH_LEFT = 1u << 30;
+static constexpr u32 TOUCH_RIGHT = 1u << 29;
+
+static constexpr PS4Button s_buttons[] = {
+  {"Cross", ORBIS_PAD_BUTTON_CROSS, GenericInputBinding::Cross},
+  {"Circle", ORBIS_PAD_BUTTON_CIRCLE, GenericInputBinding::Circle},
+  {"Square", ORBIS_PAD_BUTTON_SQUARE, GenericInputBinding::Square},
+  {"Triangle", ORBIS_PAD_BUTTON_TRIANGLE, GenericInputBinding::Triangle},
+  {"L1", ORBIS_PAD_BUTTON_L1, GenericInputBinding::L1},
+  {"R1", ORBIS_PAD_BUTTON_R1, GenericInputBinding::R1},
+  {"L2", ORBIS_PAD_BUTTON_L2, GenericInputBinding::L2},
+  {"R2", ORBIS_PAD_BUTTON_R2, GenericInputBinding::R2},
+  {"L3", ORBIS_PAD_BUTTON_L3, GenericInputBinding::L3},
+  {"R3", ORBIS_PAD_BUTTON_R3, GenericInputBinding::R3},
+  {"Options", ORBIS_PAD_BUTTON_OPTIONS, GenericInputBinding::Start},
+  {"TouchPad", ORBIS_PAD_BUTTON_TOUCH_PAD, GenericInputBinding::Select},
+  {"DPadUp", ORBIS_PAD_BUTTON_UP, GenericInputBinding::DPadUp},
+  {"DPadDown", ORBIS_PAD_BUTTON_DOWN, GenericInputBinding::DPadDown},
+  {"DPadLeft", ORBIS_PAD_BUTTON_LEFT, GenericInputBinding::DPadLeft},
+  {"DPadRight", ORBIS_PAD_BUTTON_RIGHT, GenericInputBinding::DPadRight},
+  {"TouchLeft", TOUCH_LEFT, GenericInputBinding::Unknown},
+  {"TouchRight", TOUCH_RIGHT, GenericInputBinding::Unknown},
+};
+static_assert(std::size(s_buttons) == PS4InputSource::NUM_BUTTONS);
+
+static constexpr const char* s_axis_names[] = {"LeftX", "LeftY", "RightX", "RightY"};
+static constexpr GenericInputBinding s_generic_axis[][2] = {
+  {GenericInputBinding::LeftStickLeft, GenericInputBinding::LeftStickRight},
+  {GenericInputBinding::LeftStickUp, GenericInputBinding::LeftStickDown},
+  {GenericInputBinding::RightStickLeft, GenericInputBinding::RightStickRight},
+  {GenericInputBinding::RightStickUp, GenericInputBinding::RightStickDown},
+};
+
+static float StickValue(u8 value)
+{
+  return std::clamp((static_cast<float>(value) - 128.0f) / 127.0f, -1.0f, 1.0f);
+}
+
+PS4InputSource::PS4InputSource() = default;
+
+PS4InputSource::~PS4InputSource() = default;
+
+bool PS4InputSource::OpenPad(s32 user, u32 slot, int attempts)
+{
+  s32 handle = scePadOpen(user, 0, 0, nullptr);
+  for (int attempt = 1; attempt < attempts && handle < 0; attempt++)
+  {
+    usleep(100000);
+    handle = scePadOpen(user, 0, 0, nullptr);
+  }
+  if (handle < 0)
+  {
+    Log_WarningFmt("scePadOpen for user {:X} failed: {:08X}", static_cast<u32>(user), static_cast<u32>(handle));
+    return false;
+  }
+
+  ControllerData& cd = m_controllers[slot];
+  cd.handle = handle;
+  cd.user = user;
+  cd.connected = false;
+  cd.buttons = 0;
+  cd.axes = {};
+  Log_InfoFmt("Pad {}: user {:X}, handle {}", slot, static_cast<u32>(user), handle);
+  return true;
+}
+
+void PS4InputSource::ScanUsers()
+{
+  OrbisUserServiceLoginUserIdList users = {};
+  if (sceUserServiceGetLoginUserIdList(&users) != 0)
+    return;
+
+  for (s32 user : users.userId)
+  {
+    if (user == -1 || user == 0)
+      continue;
+
+    bool known = false;
+    int free_slot = -1;
+    for (u32 i = 0; i < NUM_CONTROLLERS; i++)
+    {
+      if (m_controllers[i].handle >= 0 && m_controllers[i].user == user)
+        known = true;
+      else if (m_controllers[i].handle < 0 && free_slot < 0)
+        free_slot = static_cast<int>(i);
+    }
+
+    if (!known && free_slot >= 0)
+      OpenPad(user, static_cast<u32>(free_slot), 1);
+  }
+}
+
+bool PS4InputSource::Initialize(SettingsInterface& si, std::unique_lock<std::mutex>& settings_lock)
+{
+  sceUserServiceInitialize(nullptr);
+  scePadInit();
+
+  u32 count = 0;
+  OrbisUserServiceLoginUserIdList users = {};
+  if (sceUserServiceGetLoginUserIdList(&users) == 0)
+  {
+    for (s32 user : users.userId)
+    {
+      if (user != -1 && user != 0 && count < NUM_CONTROLLERS && OpenPad(user, count, count == 0 ? 10 : 1))
+        count++;
+    }
+  }
+
+  if (count == 0)
+  {
+    s32 user = -1;
+    sceUserServiceGetInitialUser(&user);
+    if (!OpenPad(user, 0, 10))
+      Log_ErrorPrint("No pad could be opened");
+  }
+
+  m_next_scan = Common::Timer::GetCurrentValue() + static_cast<u64>(Common::Timer::ConvertSecondsToValue(1.0));
+  return true;
+}
+
+void PS4InputSource::UpdateSettings(SettingsInterface& si, std::unique_lock<std::mutex>& settings_lock)
+{
+}
+
+void PS4InputSource::Shutdown()
+{
+  for (ControllerData& cd : m_controllers)
+  {
+    if (cd.handle >= 0)
+    {
+      OrbisPadVibeParam vibe = {};
+      scePadSetVibration(cd.handle, &vibe);
+      scePadClose(cd.handle);
+    }
+    cd = {};
+  }
+}
+
+bool PS4InputSource::ReloadDevices()
+{
+  ScanUsers();
+  return true;
+}
+
+void PS4InputSource::ReleaseAll(u32 slot)
+{
+  ControllerData& cd = m_controllers[slot];
+  for (u32 i = 0; i < NUM_AXIS; i++)
+  {
+    if (cd.axes[i] != 0.0f)
+    {
+      cd.axes[i] = 0.0f;
+      InputManager::InvokeEvents(MakeGenericControllerAxisKey(InputSourceType::PS4, slot, i), 0.0f,
+                                 GenericInputBinding::Unknown);
+    }
+  }
+
+  u32 held = cd.buttons;
+  cd.buttons = 0;
+  for (u32 i = 0; i < NUM_BUTTONS; i++)
+  {
+    if (held & s_buttons[i].mask)
+      InputManager::InvokeEvents(MakeGenericControllerButtonKey(InputSourceType::PS4, slot, i), 0.0f,
+                                 s_buttons[i].generic);
+  }
+}
+
+void PS4InputSource::UpdateState(u32 slot)
+{
+  ControllerData& cd = m_controllers[slot];
+  OrbisPadData data = {};
+  const bool read = (scePadReadState(cd.handle, &data) == 0);
+  const bool connected = read && data.connected;
+  const TinyString ident = TinyString::from_format("P{}", slot);
+
+  if (connected != cd.connected)
+  {
+    cd.connected = connected;
+    if (connected)
+    {
+      Host::OnInputDeviceConnected(ident.view(), "DualShock 4");
+    }
+    else
+    {
+      ReleaseAll(slot);
+      Host::OnInputDeviceDisconnected(ident.view());
+    }
+  }
+
+  if (!connected || (data.buttons & PAD_INTERCEPTED))
+  {
+    ReleaseAll(slot);
+    return;
+  }
+
+  u32 buttons = data.buttons & ~(TOUCH_LEFT | TOUCH_RIGHT);
+  if ((buttons & ORBIS_PAD_BUTTON_TOUCH_PAD) && data.touch.fingers > 0)
+    buttons |= (data.touch.touch[0].x < 960) ? TOUCH_LEFT : TOUCH_RIGHT;
+
+  const float axes[NUM_AXIS] = {StickValue(data.leftStick.x), StickValue(data.leftStick.y),
+                                StickValue(data.rightStick.x), StickValue(data.rightStick.y)};
+  for (u32 i = 0; i < NUM_AXIS; i++)
+  {
+    if (axes[i] != cd.axes[i])
+    {
+      cd.axes[i] = axes[i];
+      InputManager::InvokeEvents(MakeGenericControllerAxisKey(InputSourceType::PS4, slot, i), axes[i],
+                                 GenericInputBinding::Unknown);
+    }
+  }
+
+  const u32 changed = buttons ^ cd.buttons;
+  cd.buttons = buttons;
+  if (changed == 0)
+    return;
+
+  for (u32 i = 0; i < NUM_BUTTONS; i++)
+  {
+    if (changed & s_buttons[i].mask)
+    {
+      InputManager::InvokeEvents(MakeGenericControllerButtonKey(InputSourceType::PS4, slot, i),
+                                 (buttons & s_buttons[i].mask) ? 1.0f : 0.0f, s_buttons[i].generic);
+    }
+  }
+}
+
+void PS4InputSource::PollEvents()
+{
+  const u64 now = Common::Timer::GetCurrentValue();
+  if (now >= m_next_scan)
+  {
+    m_next_scan = now + static_cast<u64>(Common::Timer::ConvertSecondsToValue(1.0));
+    ScanUsers();
+  }
+
+  for (u32 i = 0; i < NUM_CONTROLLERS; i++)
+  {
+    if (m_controllers[i].handle >= 0)
+      UpdateState(i);
+  }
+}
+
+std::vector<std::pair<std::string, std::string>> PS4InputSource::EnumerateDevices()
+{
+  std::vector<std::pair<std::string, std::string>> result;
+  for (u32 i = 0; i < NUM_CONTROLLERS; i++)
+  {
+    if (m_controllers[i].handle >= 0)
+      result.emplace_back(fmt::format("P{}", i), fmt::format("DualShock 4 ({})", i + 1));
+  }
+  return result;
+}
+
+std::vector<InputBindingKey> PS4InputSource::EnumerateMotors()
+{
+  std::vector<InputBindingKey> ret;
+  InputBindingKey key = {};
+  key.source_type = InputSourceType::PS4;
+  key.source_subtype = InputSubclass::ControllerMotor;
+  for (u32 i = 0; i < NUM_CONTROLLERS; i++)
+  {
+    if (m_controllers[i].handle < 0)
+      continue;
+    key.source_index = i;
+    key.data = 0;
+    ret.push_back(key);
+    key.data = 1;
+    ret.push_back(key);
+  }
+  return ret;
+}
+
+bool PS4InputSource::GetGenericBindingMapping(const std::string_view& device, GenericInputBindingMapping* mapping)
+{
+  if (device.size() != 2 || device[0] != 'P')
+    return false;
+
+  for (u32 i = 0; i < NUM_AXIS; i++)
+  {
+    mapping->emplace_back(s_generic_axis[i][0], fmt::format("{}/-{}", device, s_axis_names[i]));
+    mapping->emplace_back(s_generic_axis[i][1], fmt::format("{}/+{}", device, s_axis_names[i]));
+  }
+  for (u32 i = 0; i < NUM_BUTTONS; i++)
+  {
+    if (s_buttons[i].generic != GenericInputBinding::Unknown)
+      mapping->emplace_back(s_buttons[i].generic, fmt::format("{}/{}", device, s_buttons[i].name));
+  }
+  mapping->emplace_back(GenericInputBinding::LargeMotor, fmt::format("{}/LargeMotor", device));
+  mapping->emplace_back(GenericInputBinding::SmallMotor, fmt::format("{}/SmallMotor", device));
+  return true;
+}
+
+void PS4InputSource::UpdateMotorState(InputBindingKey key, float intensity)
+{
+  if (key.source_index >= NUM_CONTROLLERS)
+    return;
+
+  ControllerData& cd = m_controllers[key.source_index];
+  if (cd.handle < 0)
+    return;
+
+  const u8 value = static_cast<u8>(std::clamp(intensity, 0.0f, 1.0f) * 255.0f);
+  if (key.data == 0)
+    cd.large_motor = value;
+  else
+    cd.small_motor = value;
+
+  OrbisPadVibeParam vibe = {};
+  vibe.lgMotor = cd.large_motor;
+  vibe.smMotor = cd.small_motor;
+  scePadSetVibration(cd.handle, &vibe);
+}
+
+void PS4InputSource::UpdateMotorState(InputBindingKey large_key, InputBindingKey small_key, float large_intensity,
+                                      float small_intensity)
+{
+  if (large_key.source_index != small_key.source_index || large_key.source_index >= NUM_CONTROLLERS)
+  {
+    UpdateMotorState(large_key, large_intensity);
+    UpdateMotorState(small_key, small_intensity);
+    return;
+  }
+
+  ControllerData& cd = m_controllers[large_key.source_index];
+  if (cd.handle < 0)
+    return;
+
+  cd.large_motor = static_cast<u8>(std::clamp(large_intensity, 0.0f, 1.0f) * 255.0f);
+  cd.small_motor = static_cast<u8>(std::clamp(small_intensity, 0.0f, 1.0f) * 255.0f);
+  OrbisPadVibeParam vibe = {};
+  vibe.lgMotor = cd.large_motor;
+  vibe.smMotor = cd.small_motor;
+  scePadSetVibration(cd.handle, &vibe);
+}
+
+std::optional<InputBindingKey> PS4InputSource::ParseKeyString(const std::string_view& device,
+                                                              const std::string_view& binding)
+{
+  if (device.size() != 2 || device[0] != 'P' || device[1] < '0' || device[1] >= ('0' + NUM_CONTROLLERS) ||
+      binding.empty())
+  {
+    return std::nullopt;
+  }
+
+  InputBindingKey key = {};
+  key.source_type = InputSourceType::PS4;
+  key.source_index = static_cast<u32>(device[1] - '0');
+
+  if (binding[0] == '+' || binding[0] == '-')
+  {
+    const std::string_view axis = binding.substr(1);
+    for (u32 i = 0; i < NUM_AXIS; i++)
+    {
+      if (axis == s_axis_names[i])
+      {
+        key.source_subtype = InputSubclass::ControllerAxis;
+        key.modifier = (binding[0] == '-') ? InputModifier::Negate : InputModifier::None;
+        key.data = i;
+        return key;
+      }
+    }
+    return std::nullopt;
+  }
+
+  if (binding == "LargeMotor" || binding == "SmallMotor")
+  {
+    key.source_subtype = InputSubclass::ControllerMotor;
+    key.data = (binding == "LargeMotor") ? 0 : 1;
+    return key;
+  }
+
+  for (u32 i = 0; i < NUM_BUTTONS; i++)
+  {
+    if (binding == s_buttons[i].name)
+    {
+      key.source_subtype = InputSubclass::ControllerButton;
+      key.data = i;
+      return key;
+    }
+  }
+
+  return std::nullopt;
+}
+
+TinyString PS4InputSource::ConvertKeyToString(InputBindingKey key)
+{
+  TinyString ret;
+  if (key.source_type != InputSourceType::PS4)
+    return ret;
+
+  if (key.source_subtype == InputSubclass::ControllerAxis && key.data < NUM_AXIS)
+  {
+    ret.format("P{}/{}{}", static_cast<u32>(key.source_index), (key.modifier == InputModifier::Negate) ? '-' : '+',
+               s_axis_names[key.data]);
+  }
+  else if (key.source_subtype == InputSubclass::ControllerButton && key.data < NUM_BUTTONS)
+  {
+    ret.format("P{}/{}", static_cast<u32>(key.source_index), s_buttons[key.data].name);
+  }
+  else if (key.source_subtype == InputSubclass::ControllerMotor)
+  {
+    ret.format("P{}/{}Motor", static_cast<u32>(key.source_index), key.data ? "Small" : "Large");
+  }
+
+  return ret;
+}
+
+TinyString PS4InputSource::ConvertKeyToIcon(InputBindingKey key)
+{
+  return {};
+}
+
+std::unique_ptr<InputSource> InputSource::CreatePS4Source()
+{
+  return std::make_unique<PS4InputSource>();
+}
