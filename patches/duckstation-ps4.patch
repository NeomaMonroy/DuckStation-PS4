diff --git a/src/util/http_downloader_ps4.cpp b/src/util/http_downloader_ps4.cpp
new file mode 100644
index 00000000..b05e27dc
--- /dev/null
+++ b/src/util/http_downloader_ps4.cpp
@@ -0,0 +1,126 @@
+#include "http_downloader.h"
+#include "ps4_net.h"
+
+#include "common/log.h"
+#include "common/timer.h"
+
+#include <algorithm>
+#include <atomic>
+#include <thread>
+
+Log_SetChannel(HTTPDownloader);
+
+namespace {
+
+class HTTPDownloaderPS4 final : public HTTPDownloader
+{
+public:
+  explicit HTTPDownloaderPS4(std::string user_agent) : m_user_agent(std::move(user_agent)) {}
+  ~HTTPDownloaderPS4() override = default;
+
+protected:
+  using State = HTTPDownloader::Request::State;
+
+  struct PS4Request : HTTPDownloader::Request
+  {
+    std::thread worker;
+    std::atomic<bool> cancel{false};
+    std::atomic<bool> finished{false};
+    std::atomic<u32> received{0};
+    std::atomic<u32> expected{0};
+    s32 result_status = 0;
+    std::string result_type;
+    Data result_data;
+  };
+
+  HTTPDownloader::Request* InternalCreateRequest() override { return new PS4Request(); }
+
+  void InternalPollRequests() override
+  {
+    for (HTTPDownloader::Request* base : m_pending_http_requests)
+    {
+      PS4Request* req = static_cast<PS4Request*>(base);
+      const State state = req->state.load(std::memory_order_acquire);
+      if (state != State::Started && state != State::Receiving)
+        continue;
+
+      if (!req->finished.load(std::memory_order_acquire))
+      {
+        if (req->received.load(std::memory_order_relaxed) > 0)
+        {
+          req->content_length = req->expected.load(std::memory_order_relaxed);
+          req->start_time = Common::Timer::GetCurrentValue();
+          req->state.store(State::Receiving, std::memory_order_release);
+        }
+        continue;
+      }
+
+      if (req->worker.joinable())
+        req->worker.join();
+      req->status_code = req->result_status;
+      req->content_type = std::move(req->result_type);
+      req->data = std::move(req->result_data);
+      req->content_length = static_cast<u32>(req->data.size());
+      req->state.store(State::Complete, std::memory_order_release);
+    }
+  }
+
+  bool StartRequest(HTTPDownloader::Request* base) override
+  {
+    PS4Request* req = static_cast<PS4Request*>(base);
+    req->state.store(State::Started, std::memory_order_release);
+    req->start_time = Common::Timer::GetCurrentValue();
+
+    PS4Net::Request net;
+    net.url = req->url;
+    net.method = req->type == HTTPDownloader::Request::Type::Post ? "POST" : "GET";
+    net.body = req->post_data;
+    net.user_agent = m_user_agent;
+    net.timeout_seconds = m_timeout > 0.0f ? static_cast<long>(m_timeout) + 5 : 0;
+    net.error_body = true;
+    net.cancel = &req->cancel;
+    net.progress = [req](int64_t done, int64_t total) {
+      req->received.store(static_cast<u32>(std::max<int64_t>(done, 0)), std::memory_order_relaxed);
+      req->expected.store(static_cast<u32>(std::max<int64_t>(total, 0)), std::memory_order_relaxed);
+      return !req->cancel.load(std::memory_order_relaxed);
+    };
+
+    req->worker = std::thread([req, net = std::move(net)]() {
+      PS4Net::Response response = PS4Net::Fetch(net);
+      if (response.status > 0 && response.error.empty())
+      {
+        req->result_status = static_cast<s32>(response.status);
+        req->result_type = response.Header("Content-Type");
+        req->result_data.assign(response.body.begin(), response.body.end());
+      }
+      else
+      {
+        req->result_status =
+          response.error.find("Timeout") != std::string::npos ? HTTP_STATUS_TIMEOUT : HTTP_STATUS_ERROR;
+        if (response.error != "cancelled")
+          Log_ErrorPrintf("Request for '%s' failed: %s", net.url.c_str(), response.error.c_str());
+      }
+      req->finished.store(true, std::memory_order_release);
+    });
+    return true;
+  }
+
+  void CloseRequest(HTTPDownloader::Request* base) override
+  {
+    PS4Request* req = static_cast<PS4Request*>(base);
+    req->cancel.store(true, std::memory_order_release);
+    if (req->worker.joinable())
+      req->worker.join();
+    delete req;
+  }
+
+private:
+  std::string m_user_agent;
+};
+
+}
+
+std::unique_ptr<HTTPDownloader> HTTPDownloader::Create(std::string user_agent)
+{
+  return std::make_unique<HTTPDownloaderPS4>(std::move(user_agent));
+}
