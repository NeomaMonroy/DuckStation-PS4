+#pragma once
+
+#include "input_source.h"
+
+#include <array>
+#include <mutex>
+#include <vector>
+
+class SettingsInterface;
+
+class PS4InputSource final : public InputSource
+{
+public:
+  PS4InputSource();
+  ~PS4InputSource();
+
+  bool Initialize(SettingsInterface& si, std::unique_lock<std::mutex>& settings_lock) override;
+  void UpdateSettings(SettingsInterface& si, std::unique_lock<std::mutex>& settings_lock) override;
+  void Shutdown() override;
+  bool ReloadDevices() override;
+
+  void PollEvents() override;
+  std::vector<std::pair<std::string, std::string>> EnumerateDevices() override;
+  std::vector<InputBindingKey> EnumerateMotors() override;
+  bool GetGenericBindingMapping(const std::string_view& device, GenericInputBindingMapping* mapping) override;
+  void UpdateMotorState(InputBindingKey key, float intensity) override;
+  void UpdateMotorState(InputBindingKey large_key, InputBindingKey small_key, float large_intensity,
+                        float small_intensity) override;
+
+  std::optional<InputBindingKey> ParseKeyString(const std::string_view& device,
+                                                const std::string_view& binding) override;
+  TinyString ConvertKeyToString(InputBindingKey key) override;
+  TinyString ConvertKeyToIcon(InputBindingKey key) override;
+
+  enum : u32
+  {
+    NUM_CONTROLLERS = 4,
+    NUM_BUTTONS = 18,
+    NUM_AXIS = 4,
+  };
+
+private:
+  struct ControllerData
+  {
+    s32 handle = -1;
+    s32 user = -1;
+    bool connected = false;
+    u32 buttons = 0;
+    std::array<float, NUM_AXIS> axes = {};
+    u8 large_motor = 0;
+    u8 small_motor = 0;
+  };
+
+  bool OpenPad(s32 user, u32 slot, int attempts);
+  void ScanUsers();
+  void ReleaseAll(u32 slot);
+  void UpdateState(u32 slot);
+
+  std::array<ControllerData, NUM_CONTROLLERS> m_controllers;
+  u64 m_next_scan = 0;
+};
diff --git a/src/util/ps4_net.cpp b/src/util/ps4_net.cpp
new file mode 100644
index 00000000..86403ebd
--- /dev/null
+++ b/src/util/ps4_net.cpp
@@ -0,0 +1,565 @@
+// SPDX-FileCopyrightText: EmuSuNi (github.com/arturofuentes1988/EmuSuNi), Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "ps4_net.h"
+
+#include "common/log.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+#include <curl/curl.h>
+#include <orbis/Sysmodule.h>
+
+Log_SetChannel(PS4Net);
+
+extern "C" {
+int sceNetInit(void);
+int sceNetPoolCreate(const char* name, int size, int flags);
+int sceNetResolverCreate(const char* name, int memid, int flags);
+int sceNetResolverDestroy(int rid);
+int sceNetResolverStartNtoa(int rid, const char* hostname, uint32_t* addr, int timeout, int retry, int flags);
+}
+
+namespace PS4Net {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+std::mutex s_init_mutex;
+int s_pool = -1;
+constexpr size_t DEFAULT_MAX_BYTES = size_t{64} << 20;
+
+bool Init(std::string* error)
+{
+  std::lock_guard lock(s_init_mutex);
+  if (s_pool >= 0)
+    return true;
+  sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_NET);
+  const int init = sceNetInit();
+  s_pool = sceNetPoolCreate("duckstation-net", 64 * 1024, 0);
+  Log_InfoPrintf("init %#x, pool %#x; %s", static_cast<unsigned>(init), static_cast<unsigned>(s_pool),
+                 curl_version());
+  curl_global_init(CURL_GLOBAL_DEFAULT);
+  if (s_pool < 0)
+  {
+    *error = "the PS4 network is not available";
+    return false;
+  }
+  return true;
+}
+
+std::string Lower(std::string text)
+{
+  for (char& c : text)
+  {
+    if (c >= 'A' && c <= 'Z')
+      c = static_cast<char>(c - 'A' + 'a');
+  }
+  return text;
+}
+
+std::string Upper(std::string text)
+{
+  for (char& c : text)
+  {
+    if (c >= 'a' && c <= 'z')
+      c = static_cast<char>(c - 'a' + 'A');
+  }
+  return text;
+}
+
+bool IsAddress(const std::string& host)
+{
+  int dots = 0;
+  for (const char c : host)
+  {
+    if (c == '.')
+      dots++;
+    else if (c < '0' || c > '9')
+      return false;
+  }
+  return dots == 3;
+}
+
+std::string Resolve(const std::string& host, std::string* error)
+{
+  if (IsAddress(host))
+    return host;
+  const int resolver = sceNetResolverCreate("duckstation-net", s_pool, 0);
+  if (resolver < 0)
+  {
+    *error = "the PS4 network is not available";
+    return {};
+  }
+  uint32_t address = 0;
+  const int result = sceNetResolverStartNtoa(resolver, host.c_str(), &address, 5 * 1000 * 1000, 2, 0);
+  sceNetResolverDestroy(resolver);
+  if (result < 0)
+  {
+    char line[160];
+    std::snprintf(line, sizeof(line), "could not look up %s (%#x): is the PS4 online?", host.c_str(),
+                  static_cast<unsigned>(result));
+    *error = line;
+    return {};
+  }
+  char text[32];
+  std::snprintf(text, sizeof(text), "%u.%u.%u.%u", address & 0xFF, (address >> 8) & 0xFF, (address >> 16) & 0xFF,
+                (address >> 24) & 0xFF);
+  return text;
+}
+
+bool SplitUrl(const std::string& url, std::string* scheme, std::string* host, int* port)
+{
+  const size_t colon = url.find("://");
+  if (colon == std::string::npos)
+    return false;
+  *scheme = Lower(url.substr(0, colon));
+  if (*scheme != "http" && *scheme != "https")
+    return false;
+  const size_t start = colon + 3;
+  const size_t end = url.find_first_of("/?#", start);
+  std::string authority = url.substr(start, end == std::string::npos ? std::string::npos : end - start);
+  if (const size_t at = authority.rfind('@'); at != std::string::npos)
+    authority = authority.substr(at + 1);
+  *port = *scheme == "https" ? 443 : 80;
+  const size_t port_colon = authority.rfind(':');
+  if (port_colon != std::string::npos)
+  {
+    const std::string digits = authority.substr(port_colon + 1);
+    char* stop = nullptr;
+    const long value = std::strtol(digits.c_str(), &stop, 10);
+    if (digits.empty() || !stop || *stop != '\0' || value <= 0 || value > 65535)
+      return false;
+    *port = static_cast<int>(value);
+    authority = authority.substr(0, port_colon);
+  }
+  *host = Lower(authority);
+  return !host->empty() && host->find_first_of("[]") == std::string::npos;
+}
+
+std::string HeaderName(const std::string& header)
+{
+  const size_t colon = header.find(':');
+  std::string name = colon == std::string::npos ? header : header.substr(0, colon);
+  while (!name.empty() && name.back() == ' ')
+    name.pop_back();
+  return Lower(name);
+}
+
+struct Transfer
+{
+  CURL* curl = nullptr;
+  const Request* request = nullptr;
+  const Sink* sink = nullptr;
+  bool begun = false;
+  bool keep = false;
+  bool stopped = false;
+  long status = 0;
+  int64_t done = 0;
+  int64_t total = -1;
+  std::vector<std::string> headers;
+  Clock::time_point last_progress{};
+};
+
+void Begin(Transfer* t)
+{
+  t->begun = true;
+  curl_easy_getinfo(t->curl, CURLINFO_RESPONSE_CODE, &t->status);
+  const bool redirect = t->status >= 300 && t->status < 400;
+  t->keep = !redirect && ((t->status >= 200 && t->status < 300) || (t->request->error_body && t->status >= 400));
+  curl_off_t length = -1;
+  curl_easy_getinfo(t->curl, CURLINFO_CONTENT_LENGTH_DOWNLOAD_T, &length);
+  t->total = length;
+}
+
+size_t Write(char* data, size_t size, size_t count, void* user)
+{
+  auto* t = static_cast<Transfer*>(user);
+  const size_t bytes = size * count;
+  if (!t->begun)
+    Begin(t);
+  if (t->stopped)
+    return 0;
+  if (!t->keep)
+    return bytes;
+  if (*t->sink && !(*t->sink)(data, bytes))
+  {
+    t->stopped = true;
+    return 0;
+  }
+  t->done += static_cast<int64_t>(bytes);
+  return bytes;
+}
+
+size_t Header(char* data, size_t size, size_t count, void* user)
+{
+  auto* t = static_cast<Transfer*>(user);
+  const size_t bytes = size * count;
+  std::string line(data, bytes);
+  while (!line.empty() && (line.back() == '\n' || line.back() == '\r'))
+    line.pop_back();
+  if (line.compare(0, 5, "HTTP/") == 0)
+    t->headers.clear();
+  else if (!line.empty())
+    t->headers.push_back(line);
+  return bytes;
+}
+
+int ProgressCallback(void* user, curl_off_t, curl_off_t, curl_off_t, curl_off_t)
+{
+  auto* t = static_cast<Transfer*>(user);
+  if (t->stopped)
+    return 1;
+  if (t->request->cancel && t->request->cancel->load())
+  {
+    t->stopped = true;
+    return 1;
+  }
+  if (!t->request->progress)
+    return 0;
+  const Clock::time_point now = Clock::now();
+  if (now - t->last_progress < std::chrono::milliseconds(100))
+    return 0;
+  t->last_progress = now;
+  if (!t->request->progress(t->keep ? t->done : 0, t->keep ? t->total : -1))
+  {
+    t->stopped = true;
+    return 1;
+  }
+  return 0;
+}
+
+Response Perform(const Request& request, const Sink& sink, void** session_curl,
+                 std::vector<std::pair<std::string, std::string>>* session_hosts)
+{
+  Response response;
+  auto fail = [&response](const std::string& error) {
+    response.error = error;
+    response.plain = Plain(response.status, error);
+    return response;
+  };
+  {
+    std::string error;
+    if (!Init(&error))
+      return fail(error);
+  }
+  std::string url = request.url;
+  std::string method = request.method.empty() ? (request.body.empty() ? "GET" : "POST") : Upper(request.method);
+  bool with_body = method != "GET" && method != "HEAD";
+  std::string first_host;
+  const Clock::time_point start = Clock::now();
+  for (int hop = 0;; hop++)
+  {
+    if (hop > std::max(0, request.max_redirects))
+      return fail("too many redirects");
+    std::string scheme, host;
+    int port = 0;
+    if (!SplitUrl(url, &scheme, &host, &port))
+      return fail("bad address: " + url);
+    if (hop == 0)
+      first_host = host;
+    std::string address, error;
+    if (session_hosts)
+    {
+      for (const auto& [known, known_address] : *session_hosts)
+      {
+        if (known == host)
+          address = known_address;
+      }
+    }
+    if (address.empty())
+    {
+      address = Resolve(host, &error);
+      if (address.empty())
+        return fail(error);
+      if (session_hosts)
+        session_hosts->emplace_back(host, address);
+    }
+    long timeout_ms = 0;
+    if (request.timeout_seconds > 0)
+    {
+      const long long spent = std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - start).count();
+      timeout_ms = static_cast<long>(request.timeout_seconds * 1000 - spent);
+      if (timeout_ms <= 0)
+        return fail("Timeout was reached (" + std::to_string(request.timeout_seconds) + " s)");
+    }
+    CURL* curl = session_curl && *session_curl ? static_cast<CURL*>(*session_curl) : curl_easy_init();
+    if (!curl)
+      return fail("curl couldn't start");
+    if (session_curl)
+    {
+      if (*session_curl)
+        curl_easy_reset(curl);
+      *session_curl = curl;
+    }
+    Transfer transfer;
+    transfer.curl = curl;
+    transfer.request = &request;
+    transfer.sink = &sink;
+    const std::string resolve = host + ":" + std::to_string(port) + ":" + address;
+    curl_slist* resolves = curl_slist_append(nullptr, resolve.c_str());
+    curl_slist* headers = nullptr;
+    bool has_type = false;
+    for (const std::string& header : request.headers)
+    {
+      const std::string name = HeaderName(header);
+      if (host != first_host && (name == "authorization" || name == "cookie"))
+        continue;
+      has_type = has_type || name == "content-type";
+      headers = curl_slist_append(headers, header.c_str());
+    }
+    if (with_body)
+    {
+      if (!has_type)
+      {
+        const std::string type =
+          "Content-Type: " +
+          (request.content_type.empty() ? std::string("application/x-www-form-urlencoded") : request.content_type);
+        headers = curl_slist_append(headers, type.c_str());
+      }
+      headers = curl_slist_append(headers, "Expect:");
+    }
+    const std::string agent = request.user_agent.empty() ? std::string("DuckStation-PS4") : request.user_agent;
+    const std::string ca = request.ca_file.empty() ? std::string("/app0/resources/cacert.pem") : request.ca_file;
+    char detail[CURL_ERROR_SIZE] = {};
+    curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+    curl_easy_setopt(curl, CURLOPT_PROTOCOLS, static_cast<long>(CURLPROTO_HTTP | CURLPROTO_HTTPS));
+    curl_easy_setopt(curl, CURLOPT_RESOLVE, resolves);
+    curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
+    curl_easy_setopt(curl, CURLOPT_USERAGENT, agent.c_str());
+    curl_easy_setopt(curl, CURLOPT_CAINFO, ca.c_str());
+    curl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, 1L);
+    curl_easy_setopt(curl, CURLOPT_SSL_VERIFYHOST, 2L);
+    curl_easy_setopt(curl, CURLOPT_SSLVERSION, static_cast<long>(CURL_SSLVERSION_TLSv1_2));
+    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 0L);
+    curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, std::max(1L, request.connect_seconds));
+    curl_easy_setopt(curl, CURLOPT_TIMEOUT_MS, timeout_ms);
+    curl_easy_setopt(curl, CURLOPT_LOW_SPEED_LIMIT, 1L);
+    curl_easy_setopt(curl, CURLOPT_LOW_SPEED_TIME, std::max(1L, request.stall_seconds));
+    curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+    curl_easy_setopt(curl, CURLOPT_ERRORBUFFER, detail);
+    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, Write);
+    curl_easy_setopt(curl, CURLOPT_WRITEDATA, &transfer);
+    curl_easy_setopt(curl, CURLOPT_HEADERFUNCTION, Header);
+    curl_easy_setopt(curl, CURLOPT_HEADERDATA, &transfer);
+    curl_easy_setopt(curl, CURLOPT_NOPROGRESS, 0L);
+    curl_easy_setopt(curl, CURLOPT_XFERINFOFUNCTION, ProgressCallback);
+    curl_easy_setopt(curl, CURLOPT_XFERINFODATA, &transfer);
+    if (method == "GET")
+    {
+      curl_easy_setopt(curl, CURLOPT_HTTPGET, 1L);
+    }
+    else if (method == "HEAD")
+    {
+      curl_easy_setopt(curl, CURLOPT_NOBODY, 1L);
+    }
+    else
+    {
+      if (method == "POST")
+        curl_easy_setopt(curl, CURLOPT_POST, 1L);
+      else
+        curl_easy_setopt(curl, CURLOPT_CUSTOMREQUEST, method.c_str());
+      curl_easy_setopt(curl, CURLOPT_POSTFIELDSIZE_LARGE, static_cast<curl_off_t>(request.body.size()));
+      curl_easy_setopt(curl, CURLOPT_POSTFIELDS, request.body.c_str());
+    }
+    const CURLcode code = curl_easy_perform(curl);
+    long status = 0;
+    curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+    char* location = nullptr;
+    curl_easy_getinfo(curl, CURLINFO_REDIRECT_URL, &location);
+    const std::string next = location ? location : "";
+    if (code == CURLE_OK && !transfer.begun)
+      Begin(&transfer);
+    curl_easy_setopt(curl, CURLOPT_HTTPHEADER, nullptr);
+    curl_easy_setopt(curl, CURLOPT_RESOLVE, nullptr);
+    curl_easy_setopt(curl, CURLOPT_ERRORBUFFER, nullptr);
+    curl_slist_free_all(headers);
+    curl_slist_free_all(resolves);
+    if (!session_curl)
+      curl_easy_cleanup(curl);
+    response.status = status;
+    response.url = url;
+    response.headers = std::move(transfer.headers);
+    response.redirects = hop;
+    if (transfer.keep)
+    {
+      response.bytes = transfer.done;
+      response.size = transfer.total;
+    }
+    if (transfer.stopped)
+    {
+      response.status = 0;
+      return fail("cancelled");
+    }
+    if (code != CURLE_OK)
+    {
+      std::string curl_error = std::string(curl_easy_strerror(code)) + (detail[0] ? std::string(": ") + detail : "");
+      Log_WarningPrintf("%s: %s", host.c_str(), curl_error.c_str());
+      response.status = 0;
+      return fail(curl_error);
+    }
+    if (status >= 300 && status < 400 && !next.empty())
+    {
+      std::string next_scheme, next_host;
+      int next_port = 0;
+      if (!SplitUrl(next, &next_scheme, &next_host, &next_port))
+      {
+        response.status = 0;
+        return fail("the server sent the request on to a bad address: " + next);
+      }
+      if (scheme == "https" && next_scheme != "https")
+      {
+        response.status = 0;
+        return fail("the server sent the request on to an insecure (http) address: " + next);
+      }
+      if (method != "GET" && method != "HEAD" &&
+          (status == 303 || ((status == 301 || status == 302) && method == "POST")))
+      {
+        method = "GET";
+        with_body = false;
+      }
+      url = next;
+      continue;
+    }
+    if (!response.ok())
+      response.plain = Plain(response.status, response.error);
+    return response;
+  }
+}
+
+}
+
+std::string Response::Header(const std::string& name) const
+{
+  const std::string wanted = Lower(name);
+  for (const std::string& header : headers)
+  {
+    if (HeaderName(header) != wanted)
+      continue;
+    const size_t colon = header.find(':');
+    size_t at = colon == std::string::npos ? header.size() : colon + 1;
+    while (at < header.size() && (header[at] == ' ' || header[at] == '\t'))
+      at++;
+    return header.substr(at);
+  }
+  return {};
+}
+
+std::string UrlEncode(const std::string& text)
+{
+  std::string out;
+  for (const unsigned char c : text)
+  {
+    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+        c == '.' || c == '~')
+    {
+      out += static_cast<char>(c);
+    }
+    else
+    {
+      char hex[4];
+      std::snprintf(hex, sizeof(hex), "%%%02X", c);
+      out += hex;
+    }
+  }
+  return out;
+}
+
+Session::~Session()
+{
+  if (m_curl)
+    curl_easy_cleanup(static_cast<CURL*>(m_curl));
+}
+
+Response Stream(const Request& request, const Sink& sink, Session* session)
+{
+  return Perform(request, sink, session ? &session->m_curl : nullptr, session ? &session->m_hosts : nullptr);
+}
+
+Response Fetch(const Request& request, Session* session)
+{
+  std::string body;
+  bool too_big = false;
+  const size_t most = request.max_bytes > 0 ? request.max_bytes : DEFAULT_MAX_BYTES;
+  Response response = Stream(
+    request,
+    [&](const char* data, size_t size) {
+      if (body.size() + size > most)
+      {
+        too_big = true;
+        return false;
+      }
+      body.append(data, size);
+      return true;
+    },
+    session);
+  if (too_big)
+  {
+    response.status = 0;
+    response.error = "the answer is too big (over " + std::to_string(most) + " bytes)";
+    response.plain = Plain(0, response.error);
+    body.clear();
+  }
+  response.body = std::move(body);
+  return response;
+}
+
+long GetText(const Request& request, std::string* body, size_t max_bytes, std::string* error, Session* session)
+{
+  body->clear();
+  const Response response = Stream(
+    request,
+    [&](const char* data, size_t size) {
+      body->append(data, size);
+      return body->size() <= max_bytes;
+    },
+    session);
+  *error = response.error;
+  return response.error.empty() ? response.status : 0;
+}
+
+std::string Plain(long status, const std::string& error)
+{
+  auto has = [&error](const char* text) { return error.find(text) != std::string::npos; };
+  if (!error.empty())
+  {
+    if (has("could not look up"))
+      return "no internet connection (the PS4 couldn't find the server)";
+    if (has("network is not available"))
+      return "the PS4's network isn't available";
+    if (has("cancelled"))
+      return "stopped";
+    if (has("too big"))
+      return "the server's answer is too big";
+    if (has("Timeout") || has("timed out") || has("too slow"))
+      return "the server took too long to answer";
+    if (has("BADCERT_EXPIRED") || has("BADCERT_FUTURE"))
+      return "the secure connection failed: check the PS4's date and time";
+    if (has("BADCERT") || has("peer certificate") || has("SSL certificate problem"))
+      return "the server's certificate isn't valid";
+    if (has("SSL") || has("TLS") || has("certificate") || has("mbedTLS") || has("insecure"))
+      return "the secure connection failed";
+    if (has("connect"))
+      return "the server didn't answer";
+    if (has("receiving") || has("Recv failure") || has("artial file") || has("Send failure") || has("reset") ||
+        has("was cut"))
+      return "the connection was cut";
+    return error;
+  }
+  if (status == 404 || status == 410)
+    return "not on the server";
+  if (status == 401 || status == 403 || status == 429)
+    return "the server refused it";
+  if (status >= 500)
+    return "the server had a problem: try again later";
+  if (status <= 0)
+    return "the server didn't answer";
+  return "the server answered with an error";
+}
+
+}
diff --git a/src/util/ps4_net.h b/src/util/ps4_net.h
new file mode 100644
index 00000000..2b78c9f5
--- /dev/null
+++ b/src/util/ps4_net.h
@@ -0,0 +1,74 @@
+// SPDX-FileCopyrightText: EmuSuNi (github.com/arturofuentes1988/EmuSuNi), Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace PS4Net {
+
+using Progress = std::function<bool(int64_t done, int64_t total)>;
+
+struct Request
+{
+  std::string url;
+  std::string method;
+  std::vector<std::string> headers;
+  std::string body;
+  std::string content_type;
+  std::string user_agent;
+  std::string ca_file;
+  long timeout_seconds = 30;
+  long connect_seconds = 15;
+  long stall_seconds = 60;
+  int max_redirects = 8;
+  bool error_body = false;
+  size_t max_bytes = 0;
+  Progress progress;
+  std::atomic<bool>* cancel = nullptr;
+};
+
+struct Response
+{
+  long status = 0;
+  std::string body;
+  std::string error;
+  std::string plain;
+  std::string url;
+  std::vector<std::string> headers;
+  int64_t bytes = 0;
+  int64_t size = -1;
+  int redirects = 0;
+  bool ok() const { return status >= 200 && status < 300 && error.empty(); }
+  std::string Header(const std::string& name) const;
+};
+
+using Sink = std::function<bool(const char* data, size_t size)>;
+
+class Session
+{
+public:
+  Session() = default;
+  ~Session();
+  Session(const Session&) = delete;
+  Session& operator=(const Session&) = delete;
+
+private:
+  friend Response Stream(const Request&, const Sink&, Session*);
+  void* m_curl = nullptr;
+  std::vector<std::pair<std::string, std::string>> m_hosts;
+};
+
+Response Fetch(const Request& request, Session* session = nullptr);
+Response Stream(const Request& request, const Sink& sink, Session* session = nullptr);
+long GetText(const Request& request, std::string* body, size_t max_bytes, std::string* error,
+             Session* session = nullptr);
+std::string UrlEncode(const std::string& text);
+std::string Plain(long status, const std::string& error);
+
+}
