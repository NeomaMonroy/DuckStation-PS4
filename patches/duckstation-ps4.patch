+std::string DecodeHref(const std::string& href)
+{
+  static const std::pair<const char*, char> ENTITIES[] = {
+    {"&amp;", '&'}, {"&#39;", '\''}, {"&quot;", '"'}, {"&lt;", '<'}, {"&gt;", '>'}};
+  std::string html;
+  for (size_t i = 0; i < href.size(); i++)
+  {
+    if (href[i] == '&')
+    {
+      bool known = false;
+      for (const auto& [entity, ch] : ENTITIES)
+      {
+        const size_t length = std::char_traits<char>::length(entity);
+        if (href.compare(i, length, entity) == 0)
+        {
+          html += ch;
+          i += length - 1;
+          known = true;
+          break;
+        }
+      }
+      if (known)
+        continue;
+    }
+    html += href[i];
+  }
+  std::string out;
+  for (size_t i = 0; i < html.size(); i++)
+  {
+    if (html[i] == '%' && i + 2 < html.size() && std::isxdigit(static_cast<unsigned char>(html[i + 1])) &&
+        std::isxdigit(static_cast<unsigned char>(html[i + 2])))
+    {
+      out += static_cast<char>(std::stoi(html.substr(i + 1, 2), nullptr, 16));
+      i += 2;
+    }
+    else
+    {
+      out += html[i];
+    }
+  }
+  return out;
+}
+
+std::vector<std::string> ListedPictures(const std::string& html)
+{
+  std::vector<std::string> names;
+  for (size_t at = html.find("href=\""); at != std::string::npos; at = html.find("href=\"", at + 6))
+  {
+    const size_t start = at + 6;
+    const size_t end = html.find('"', start);
+    if (end == std::string::npos)
+      break;
+    const std::string name = DecodeHref(html.substr(start, end - start));
+    if (name.size() > 4 && name.compare(name.size() - 4, 4, ".png") == 0 && name.find('/') == std::string::npos &&
+        name.find('?') == std::string::npos)
+    {
+      names.push_back(name.substr(0, name.size() - 4));
+    }
+  }
+  return names;
+}
+
+std::vector<std::string> Paths(const std::string& json, std::vector<std::string>* shas)
+{
+  std::vector<std::string> paths;
+  auto read_string = [&](size_t at, size_t* end) {
+    std::string value;
+    size_t i = at;
+    for (; i < json.size() && json[i] != '"'; i++)
+    {
+      if (json[i] == '\\' && i + 1 < json.size())
+      {
+        const char next = json[++i];
+        if (next == 'u' && i + 4 < json.size())
+        {
+          const unsigned code = std::stoul(json.substr(i + 1, 4), nullptr, 16);
+          i += 4;
+          if (code < 0x80)
+          {
+            value += static_cast<char>(code);
+          }
+          else if (code < 0x800)
+          {
+            value += static_cast<char>(0xC0 | (code >> 6));
+            value += static_cast<char>(0x80 | (code & 0x3F));
+          }
+          else
+          {
+            value += static_cast<char>(0xE0 | (code >> 12));
+            value += static_cast<char>(0x80 | ((code >> 6) & 0x3F));
+            value += static_cast<char>(0x80 | (code & 0x3F));
+          }
+        }
+        else
+        {
+          value += next == 'n' ? '\n' : next;
+        }
+      }
+      else
+      {
+        value += json[i];
+      }
+    }
+    *end = i;
+    return value;
+  };
+  for (size_t at = json.find("\"path\""); at != std::string::npos; at = json.find("\"path\"", at + 6))
+  {
+    const size_t quote = json.find('"', json.find(':', at) + 1);
+    if (quote == std::string::npos)
+      break;
+    size_t end = quote;
+    paths.push_back(read_string(quote + 1, &end));
+    if (shas)
+    {
+      const size_t object_end = json.find('}', end);
+      const size_t f = json.find("\"sha\"", end);
+      if (f == std::string::npos || f > object_end)
+      {
+        shas->emplace_back();
+      }
+      else
+      {
+        const size_t q = json.find('"', json.find(':', f) + 1);
+        size_t e = q;
+        shas->push_back(read_string(q + 1, &e));
+      }
+    }
+  }
+  return paths;
+}
+
+std::vector<std::string> Names(const Kind& kind, const std::string& covers_dir, std::string* error,
+                               PS4Net::Session* session)
+{
+  const std::string cache = Path::Combine(covers_dir, kind.cache);
+  std::vector<std::string> names;
+  struct stat info = {};
+  if (stat(cache.c_str(), &info) == 0 && std::time(nullptr) - info.st_mtime < 7 * 24 * 3600)
+  {
+    if (const std::optional<std::string> text = FileSystem::ReadFileToString(cache.c_str()))
+    {
+      std::istringstream in(*text);
+      std::string line;
+      while (std::getline(in, line))
+      {
+        if (!line.empty())
+          names.push_back(line);
+      }
+      if (!names.empty())
+        return names;
+    }
+  }
+  auto keep = [&](const char* where) {
+    std::string text;
+    for (const std::string& name : names)
+      text += name + "\n";
+    FileSystem::WriteBinaryFile(cache.c_str(), text.data(), text.size());
+    Log_InfoPrintf("%zu %s pictures listed by %s", names.size(), kind.label, where);
+  };
+  {
+    PS4Net::Request request;
+    request.url = std::string(SERVER) + kind.folder + "/";
+    std::string html, server_error;
+    const long status = PS4Net::GetText(request, &html, 16 << 20, &server_error, session);
+    if (status == 200)
+      names = ListedPictures(html);
+    if (!names.empty())
+    {
+      keep("thumbnails.libretro.com");
+      return names;
+    }
+    Log_WarningPrintf("thumbnails.libretro.com: %s; asking GitHub",
+                      server_error.empty() ? ("HTTP " + std::to_string(status)).c_str() : server_error.c_str());
+  }
+  PS4Net::Request request;
+  request.headers = {"Accept: application/vnd.github+json"};
+  std::string root;
+  for (const char* branch : {"master", "main"})
+  {
+    request.url = std::string("https://api.github.com/repos/") + GITHUB_REPO + "/git/trees/" + branch;
+    if (PS4Net::GetText(request, &root, 1 << 20, error, session) == 200)
+      break;
+    root.clear();
+  }
+  if (root.empty())
+  {
+    if (error->empty())
+      *error = "GitHub didn't answer";
+    return {};
+  }
+  std::vector<std::string> shas;
+  const std::vector<std::string> top = Paths(root, &shas);
+  std::string sha;
+  for (size_t i = 0; i < top.size(); i++)
+  {
+    if (top[i] == kind.folder && i < shas.size())
+      sha = shas[i];
+  }
+  if (sha.empty())
+  {
+    *error = std::string("no ") + kind.folder + " folder in libretro's thumbnails";
+    return {};
+  }
+  std::string listing;
+  request.url = std::string("https://api.github.com/repos/") + GITHUB_REPO + "/git/trees/" + sha;
+  if (PS4Net::GetText(request, &listing, 16 << 20, error, session) != 200)
+  {
+    if (error->empty())
+      *error = "the list of pictures couldn't be read";
+    return {};
+  }
+  for (const std::string& path : Paths(listing, nullptr))
+  {
+    if (path.size() > 4 && path.compare(path.size() - 4, 4, ".png") == 0)
+      names.push_back(path.substr(0, path.size() - 4));
+  }
+  keep("GitHub");
+  return names;
+}
+
+std::string Undecorated(const std::string& name)
+{
+  size_t i = 0;
+  const char open = !name.empty() && (name[0] == '[' || name[0] == '(' || name[0] == '#') ? name[0] : '\0';
+  if (open)
+    i++;
+  const size_t digits = i;
+  while (i < name.size() && std::isdigit(static_cast<unsigned char>(name[i])))
+    i++;
+  if (i == digits || i - digits > 4)
+    return {};
+  if (open == '[' || open == '(')
+  {
+    if (i >= name.size() || name[i] != (open == '[' ? ']' : ')'))
+      return {};
+    i++;
+  }
+  const size_t separator = i;
+  while (i < name.size() && (name[i] == ' ' || name[i] == '-' || name[i] == '_' || name[i] == '.' || name[i] == ')'))
+    i++;
+  if (i == separator && !open)
+    return {};
+  if (i >= name.size() || !std::isalnum(static_cast<unsigned char>(name[i])))
+    return {};
+  const std::string rest = name.substr(i);
+  const bool letters =
+    std::any_of(rest.begin(), rest.end(), [](char c) { return std::isalpha(static_cast<unsigned char>(c)); });
+  return letters ? rest : std::string();
+}
+
+std::string TitlePart(const std::string& name)
+{
+  for (size_t i = 1; i < name.size(); i++)
+  {
+    if (name[i] == '(' || name[i] == '[')
+      return name.substr(0, i);
+  }
+  return name;
+}
+
+std::vector<std::string> Words(const std::string& text)
+{
+  static const std::map<std::string, std::string> ROMAN = {{"ii", "2"},  {"iii", "3"}, {"iv", "4"},
+                                                            {"v", "5"},   {"vi", "6"},  {"vii", "7"},
+                                                            {"viii", "8"}, {"ix", "9"}};
+  std::vector<std::string> words;
+  std::string word;
+  auto flush = [&] {
+    if (word.empty())
+      return;
+    if (const auto it = ROMAN.find(word); it != ROMAN.end())
+      word = it->second;
+    if (word != "the" && word != "a" && word != "an" && word != "and")
+      words.push_back(word);
+    word.clear();
+  };
+  for (const char ch : text)
+  {
+    const unsigned char c = static_cast<unsigned char>(ch);
+    if (c == '\'' || c == '.')
+      continue;
+    if (c == '$')
+      word += 's';
+    else if (std::isalnum(c))
+      word += static_cast<char>(std::tolower(c));
+    else
+      flush();
+  }
+  flush();
+  return words;
+}
+
+std::string Joined(const std::vector<std::string>& words, const char* separator = "")
+{
+  std::string out;
+  for (const std::string& word : words)
+    out += (out.empty() ? "" : separator) + word;
+  return out;
+}
+
+std::vector<std::string> Numbers(const std::vector<std::string>& words)
+{
+  std::vector<std::string> numbers;
+  for (const std::string& word : words)
+  {
+    if (std::all_of(word.begin(), word.end(), [](char c) { return std::isdigit(static_cast<unsigned char>(c)); }))
+      numbers.push_back(word);
+  }
+  std::sort(numbers.begin(), numbers.end());
+  return numbers;
+}
+
+std::vector<std::string> Parts(const std::string& title)
+{
+  std::vector<std::string> parts;
+  size_t start = 0;
+  for (size_t at; (at = title.find(" - ", start)) != std::string::npos; start = at + 3)
+    parts.push_back(title.substr(start, at - start));
+  parts.push_back(title.substr(start));
+  return parts;
+}
+
+double Similarity(const std::string& a, const std::string& b)
+{
+  if (a.empty() || b.empty())
+    return 0.0;
+  std::vector<int> previous(b.size() + 1, 0), row(b.size() + 1, 0);
+  for (size_t i = 1; i <= a.size(); i++)
+  {
+    for (size_t j = 1; j <= b.size(); j++)
+      row[j] = a[i - 1] == b[j - 1] ? previous[j - 1] + 1 : std::max(previous[j], row[j - 1]);
+    std::swap(previous, row);
+  }
+  return 2.0 * previous[b.size()] / static_cast<double>(a.size() + b.size());
+}
+
+class NameIndex
+{
+public:
+  explicit NameIndex(const std::vector<std::string>& names)
+  {
+    for (const std::string& name : names)
+    {
+      const std::string title = TitlePart(name);
+      std::vector<std::string> words = Words(title);
+      const std::string key = Joined(words);
+      if (key.empty())
+        continue;
+      Entry& entry = m_names[key];
+      if (entry.names.empty())
+        entry.words = words;
+      entry.names.push_back(&name);
+      std::sort(words.begin(), words.end());
+      m_sorted[Joined(words, " ")].push_back(&name);
+      const std::vector<std::string> parts = Parts(title);
+      if (parts.size() > 1)
+      {
+        m_first[Joined(Words(parts[0]))].push_back(&name);
+        for (size_t i = 1; i < parts.size(); i++)
+        {
+          const std::string part = Joined(Words(parts[i]));
+          if (part.size() >= 6)
+            m_subtitle[part].push_back(&name);
+        }
+      }
+    }
+  }
+
+  std::vector<const std::string*> Find(const std::string& stem, std::string* how, bool strict = false) const
+  {
+    const std::string title = TitlePart(stem);
+    const std::vector<std::string> words = Words(title);
+    const std::string key = Joined(words);
+    if (key.empty())
+      return {};
+    auto found = [&](const std::vector<const std::string*>& names, const char* way) {
+      *how = way;
+      return names;
+    };
+    if (const auto it = m_names.find(key); it != m_names.end())
+      return found(it->second.names, "same name");
+    if (strict)
+      return {};
+    {
+      std::vector<std::string> sorted = words;
+      std::sort(sorted.begin(), sorted.end());
+      if (const auto it = m_sorted.find(Joined(sorted, " ")); it != m_sorted.end())
+        return found(it->second, "same words");
+    }
+    const std::vector<std::string> parts = Parts(title);
+    if (parts.size() > 1)
+    {
+      if (const auto it = m_names.find(Joined(Words(parts[0]))); it != m_names.end())
+        return found(it->second.names, "its first part");
+      for (size_t i = 1; i < parts.size(); i++)
+      {
+        const std::string part = Joined(Words(parts[i]));
+        const auto it = m_subtitle.find(part);
+        if (part.size() >= 6 && it != m_subtitle.end() && it->second.size() <= 3)
+          return found(it->second, "same subtitle");
+      }
+    }
+    if (const auto it = m_first.find(key); it != m_first.end())
+      return found(it->second, "their first part");
+    if (const auto it = m_subtitle.find(key); it != m_subtitle.end() && it->second.size() <= 3)
+      return found(it->second, "their subtitle");
+    const std::vector<std::string> numbers = Numbers(words);
+    {
+      const Entry* best = nullptr;
+      double best_score = 0.88;
+      for (const auto& [name_key, entry] : m_names)
+      {
+        const double longer = static_cast<double>(std::max(name_key.size(), key.size()));
+        if (std::abs(static_cast<double>(name_key.size()) - static_cast<double>(key.size())) > longer * 0.25)
+          continue;
+        const double score = Similarity(key, name_key);
+        if (score > best_score && Numbers(entry.words) == numbers)
+        {
+          best = &entry;
+          best_score = score;
+        }
+      }
+      if (best)
+        return found(best->names, "close spelling");
+    }
+    {
+      const Entry* best = nullptr;
+      int hits = 0;
+      for (const auto& [name_key, entry] : m_names)
+      {
+        const std::string& shorter = name_key.size() <= key.size() ? name_key : key;
+        const std::string& longer = name_key.size() <= key.size() ? key : name_key;
+        if (shorter.size() >= 9 && shorter.size() * 100 >= longer.size() * 45 &&
+            longer.find(shorter) != std::string::npos && Numbers(entry.words) == numbers)
+        {
+          hits++;
+          if (!best || name_key.size() > Joined(best->words).size())
+            best = &entry;
+        }
+      }
+      if (best && hits <= 2)
+        return found(best->names, "inside");
+    }
+    if (words.size() >= 2)
+    {
+      const Entry* best = nullptr;
+      double best_share = 0.0;
+      for (const auto& [name_key, entry] : m_names)
+      {
+        const bool all = std::all_of(words.begin(), words.end(), [&](const std::string& word) {
+          return std::find(entry.words.begin(), entry.words.end(), word) != entry.words.end();
+        });
+        const double share = static_cast<double>(words.size()) / static_cast<double>(entry.words.size());
+        if (all && share > best_share)
+        {
+          best = &entry;
+          best_share = share;
+        }
+      }
+      if (best && best_share >= 0.5)
+        return found(best->names, "words");
+    }
+    return {};
+  }
+
+private:
+  struct Entry
+  {
+    std::vector<std::string> words;
+    std::vector<const std::string*> names;
+  };
+  std::map<std::string, Entry> m_names;
+  std::map<std::string, std::vector<const std::string*>> m_sorted, m_first, m_subtitle;
+};
+
+const std::string* Pick(const std::vector<const std::string*>& candidates, const Game& game)
+{
+  const std::string* best = nullptr;
+  int best_score = -1000;
+  const std::string bare_id = Undecorated(game.id);
+  for (const std::string* name : candidates)
+  {
+    int score = *name == game.id || (!bare_id.empty() && *name == bare_id) ? 20 : 0;
+    if (!game.region.empty() &&
+        (name->find("(" + game.region) != std::string::npos || name->find(", " + game.region) != std::string::npos))
+      score += 10;
+    if (game.multi_disc && name->find("(Disc 1)") != std::string::npos)
+      score += 3;
+    if (name->find("(USA") != std::string::npos)
+      score += 2;
+    for (const char* bad : {"(Beta", "(Proto", "(Sample", "(Demo", "(Pirate", "(Unl"})
+    {
+      if (name->find(bad) != std::string::npos)
+        score -= 5;
+    }
+    if (name->find("SymbolicLink") != std::string::npos)
+      score -= 8;
+    for (const char* rerelease : {"PSOne Books", "Greatest Hits", "Platinum", "Best", "Edition)"})
+    {
+      if (name->find(rerelease) != std::string::npos)
+        score -= 3;
+    }
+    score -= std::max(0, static_cast<int>(std::count(name->begin(), name->end(), '(')) - 1);
+    if (name->find('[') != std::string::npos)
+      score -= 4;
+    if (score > best_score)
+    {
+      best_score = score;
+      best = name;
+    }
+  }
+  return best;
+}
+
+bool Filler(const std::string& word)
+{
+  static const std::set<std::string> FILLER = {"of", "in",  "on", "to", "no",  "vs", "de", "del", "la",
+                                               "las", "el", "los", "lo", "y",   "e",  "en", "un",  "una",
+                                               "da", "do",  "du", "le", "les", "des", "di", "il"};
+  return FILLER.count(word) > 0;
+}
+
+bool IsNumber(const std::string& word)
+{
+  return !word.empty() &&
+         std::all_of(word.begin(), word.end(), [](char c) { return std::isdigit(static_cast<unsigned char>(c)) != 0; });
+}
+
+std::vector<std::string> ContentWords(const std::vector<std::string>& words)
+{
+  std::vector<std::string> out;
+  for (const std::string& word : words)
+  {
+    if (!Filler(word))
+      out.push_back(word);
+  }
+  return out;
+}
+
+struct Title
+{
+  std::string joined;
+  std::vector<std::string> words, numbers;
+  std::vector<const std::string*> names;
+};
+
+struct Titles
+{
+  std::vector<Title> titles;
+  std::unordered_map<std::string, int> uses;
+};
+
+Titles ReadTitles(const std::vector<std::string>& names)
+{
+  Titles list;
+  std::unordered_map<std::string, size_t> at;
+  for (const std::string& name : names)
+  {
+    const std::vector<std::string> all = Words(TitlePart(name));
+    std::vector<std::string> words = ContentWords(all);
+    std::string joined = Joined(words);
+    if (joined.empty())
+      continue;
+    const auto it = at.find(joined);
+    if (it != at.end())
+    {
+      list.titles[it->second].names.push_back(&name);
+      continue;
+    }
+    at.emplace(joined, list.titles.size());
+    for (const std::string& word : std::set<std::string>(words.begin(), words.end()))
+      list.uses[word]++;
+    list.titles.push_back({std::move(joined), std::move(words), Numbers(all), {&name}});
+  }
+  return list;
+}
+
+bool Significant(const Titles& list, const std::string& word)
+{
+  if (word.size() < (IsNumber(word) ? 3u : 4u))
+    return false;
+  const auto it = list.uses.find(word);
+  return it == list.uses.end() || static_cast<size_t>(it->second) * 50 < list.titles.size();
+}
+
+const std::string* Nearest(const Titles& list, const std::string& stem, const Game& game, bool* sure)
+{
+  *sure = false;
+  const std::vector<std::string> all = Words(TitlePart(stem));
+  const std::vector<std::string> wanted = ContentWords(all);
+  if (wanted.empty())
+    return nullptr;
+  const std::string joined = Joined(wanted);
+  const std::vector<std::string> numbers = Numbers(all);
+  const Title* best = nullptr;
+  double best_score = 0.0;
+  for (const Title& title : list.titles)
+  {
+    bool other_game = false;
+    double number_penalty = 0.0;
+    for (const std::string& number : title.numbers)
+      other_game = other_game || std::find(numbers.begin(), numbers.end(), number) == numbers.end();
+    for (const std::string& number : numbers)
+    {
+      if (std::find(title.numbers.begin(), title.numbers.end(), number) == title.numbers.end())
+      {
+        if (number.size() == 1)
+          other_game = true;
+        else
+          number_penalty += 20.0;
+      }
+    }
+    if (other_game)
+      continue;
+    double shared = 0.0;
+    bool significant = false;
+    for (const std::string& word : wanted)
+    {
+      if (std::find(title.words.begin(), title.words.end(), word) != title.words.end())
+      {
+        shared += 1.0;
+        significant = significant || Significant(list, word);
+      }
+    }
+    const double close = Similarity(joined, title.joined);
+    const std::string& shorter = title.joined.size() <= joined.size() ? title.joined : joined;
+    const std::string& longer = title.joined.size() <= joined.size() ? joined : title.joined;
+    const bool inside = shorter.size() >= 6 && longer.find(shorter) != std::string::npos;
+    if (!significant && !(inside && shorter.size() >= 8) && close < 0.8)
+      continue;
+    const double coverage = shared / static_cast<double>(wanted.size());
+    const double precision = shared / static_cast<double>(title.words.size());
+    const double score = coverage * 60.0 + precision * 25.0 + close * 60.0 + (inside ? 15.0 : 0.0) - number_penalty;
+    if (score > best_score)
+    {
+      best_score = score;
+      best = &title;
+      *sure = number_penalty == 0.0 && close >= 0.9;
+    }
+  }
+  return best ? Pick(best->names, game) : nullptr;
+}
+
+const char* RegionName(DiscRegion region)
+{
+  switch (region)
+  {
+    case DiscRegion::NTSC_U:
+      return "USA";
+    case DiscRegion::NTSC_J:
+      return "Japan";
+    case DiscRegion::PAL:
+      return "Europe";
+    default:
+      return "";
+  }
+}
+
+std::vector<Game> CollectGames(int* already)
+{
+  std::vector<Game> games;
+  const auto lock = GameList::GetLock();
+  const u32 count = GameList::GetEntryCount();
+  for (u32 i = 0; i < count; i++)
+  {
+    const GameList::Entry* entry = GameList::GetEntryByIndex(i);
+    if (!entry || (entry->type != GameList::EntryType::Disc && entry->type != GameList::EntryType::Playlist))
+      continue;
+    if (!GameList::GetCoverImagePathForEntry(entry).empty())
+    {
+      (*already)++;
+      continue;
+    }
+    Game game;
+    game.id = std::string(Path::GetFileTitle(entry->path));
+    game.title = entry->title;
+    game.key = entry->serial.empty() ? Path::SanitizeFileName(game.id) : Path::SanitizeFileName(entry->serial);
+    game.region = RegionName(entry->region);
+    game.multi_disc = entry->type == GameList::EntryType::Playlist || entry->disc_set_index >= 0 ||
+                      game.id.find("Disc") != std::string::npos;
+    games.push_back(std::move(game));
+  }
+  return games;
+}
+
+bool IsPng(const std::string& data)
+{
+  return data.size() > 8 && data.compare(1, 3, "PNG") == 0;
+}
+
+void Run()
+{
+  const std::string covers_dir = EmuFolders::Covers;
+  FileSystem::CreateDirectory(covers_dir.c_str(), true);
+
+  int already = 0, downloaded = 0, not_found = 0, failed = 0;
+  std::string first_error;
+  std::vector<Game> games = CollectGames(&already);
+  const int total = static_cast<int>(games.size());
+  Log_InfoPrintf("%d games without a cover, %d already have one", total, already);
+
+  ImGuiFullscreen::OpenBackgroundProgressDialog(PROGRESS_ID, "Downloading covers...", 0, std::max(total, 1), 0);
+
+  PS4Net::Session session;
+  std::vector<std::string> names[KIND_COUNT];
+  std::unique_ptr<NameIndex> indexes[KIND_COUNT];
+  std::unique_ptr<Titles> titles[KIND_COUNT];
+  bool listed[KIND_COUNT] = {};
+  bool github = true;
+
+  for (int i = 0; i < total; i++)
+  {
+    const Game& game = games[i];
+    ImGuiFullscreen::UpdateBackgroundProgressDialog(
+      PROGRESS_ID, "Downloading covers: " + (game.title.empty() ? game.id : game.title), 0, total, i);
+
+    std::vector<std::string> stems = {game.id};
+    if (!game.title.empty() && game.title != game.id)
+      stems.push_back(game.title);
+    std::vector<std::string> bare;
+    for (const std::string& stem : stems)
+    {
+      const std::string without = Undecorated(stem);
+      if (!without.empty() && std::find(stems.begin(), stems.end(), without) == stems.end() &&
+          std::find(bare.begin(), bare.end(), without) == bare.end())
+        bare.push_back(without);
+    }
+    struct Pass
+    {
+      const std::vector<std::string>* names;
+      bool strict;
+    };
+    std::vector<Pass> passes = {{&stems, false}};
+    if (!bare.empty())
+      passes = {{&stems, true}, {&bare, false}, {&stems, false}};
+
+    const std::string* name = nullptr;
+    const Kind* kind = nullptr;
+    std::string how;
+    for (const Pass& pass : passes)
+    {
+      for (int k = 0; k < KIND_COUNT && !name; k++)
+      {
+        if (!listed[k])
+        {
+          listed[k] = true;
+          std::string error;
+          names[k] = Names(KINDS[k], covers_dir, &error, &session);
+          indexes[k] = std::make_unique<NameIndex>(names[k]);
+          if (names[k].empty())
+          {
+            Log_ErrorPrintf("%s: no list: %s", KINDS[k].label, error.c_str());
+            if (first_error.empty())
+              first_error = PS4Net::Plain(0, error);
+          }
+        }
+        for (size_t s = 0; s < pass.names->size() && !name; s++)
+          name = Pick(indexes[k]->Find((*pass.names)[s], &how, pass.strict), game);
+        if (name)
+          kind = &KINDS[k];
+      }
+      if (name)
+        break;
+    }
+
+    for (int k = 0; !name && k < KIND_COUNT; k++)
+    {
+      if (names[k].empty())
+        continue;
+      if (!titles[k])
+        titles[k] = std::make_unique<Titles>(ReadTitles(names[k]));
+      for (const std::vector<std::string>* tried : {&stems, &bare})
+      {
+        for (const std::string& stem : *tried)
+        {
+          bool sure = false;
+          const std::string* guess = Nearest(*titles[k], stem, game, &sure);
+          if (guess && sure)
+          {
+            name = guess;
+            kind = &KINDS[k];
+            how = "closest";
+            break;
+          }
+        }
+        if (name)
+          break;
+      }
+    }
+
+    if (!name)
+    {
+      if (names[0].empty())
+        failed++;
+      else
+        not_found++;
+      Log_WarningPrintf("%s: no picture found", game.id.c_str());
+      continue;
+    }
+
+    Log_InfoPrintf("%s -> %s (%s, %s)", game.id.c_str(), name->c_str(), kind->label, how.c_str());
+    const std::string target = Path::Combine(covers_dir, game.key + ".png");
+    if (FileSystem::FileExists(target.c_str()))
+    {
+      already++;
+      continue;
+    }
+
+    PS4Net::Request request;
+    request.url = std::string(SERVER) + kind->folder + "/" + PS4Net::UrlEncode(*name) + ".png";
+    std::string picture, error;
+    long status = PS4Net::GetText(request, &picture, 8 << 20, &error, &session);
+    if ((status != 200 || !IsPng(picture)) && github)
+    {
+      request.url = std::string("https://raw.githubusercontent.com/") + GITHUB_REPO + "/master/" + kind->folder +
+                    "/" + PS4Net::UrlEncode(*name) + ".png";
+      error.clear();
+      status = PS4Net::GetText(request, &picture, 8 << 20, &error, &session);
+      if (status == 0)
+        github = false;
+    }
+    if (status != 200 || !IsPng(picture))
+    {
+      failed++;
+      if (first_error.empty())
+        first_error = status == 200 ? std::string("what came isn't a picture") : PS4Net::Plain(status, error);
+      Log_ErrorPrintf("%s: %s", game.id.c_str(), error.empty() ? ("HTTP " + std::to_string(status)).c_str() : error.c_str());
+      continue;
+    }
+
+    const std::string part = target + ".part";
+    if (FileSystem::WriteBinaryFile(part.c_str(), picture.data(), picture.size()) &&
+        FileSystem::RenamePath(part.c_str(), target.c_str()))
+    {
+      downloaded++;
+    }
+    else
+    {
+      FileSystem::DeleteFile(part.c_str());
+      failed++;
+      if (first_error.empty())
+        first_error = "the storage is full or can't be written";
+    }
+  }
+
+  ImGuiFullscreen::CloseBackgroundProgressDialog(PROGRESS_ID);
+  Log_InfoPrintf("%d downloaded, %d already there, %d not found, %d failed", downloaded, already, not_found, failed);
+
+  std::string message = std::to_string(downloaded) + " downloaded, " + std::to_string(already) + " already there";
+  if (not_found > 0)
+    message += ", " + std::to_string(not_found) + " not found";
+  if (failed > 0)
+    message += ", " + std::to_string(failed) + " failed (" + first_error + ")";
+
+  Host::RunOnCPUThread([message = std::move(message)]() {
+    FullscreenUI::InvalidateCoverCache();
+    ImGuiFullscreen::ShowToast("Covers", message, 10.0f);
+  });
+  s_running.store(false);
+}
+
+}
+
+void Start()
+{
+  bool expected = false;
+  if (!s_running.compare_exchange_strong(expected, true))
+    return;
+  std::thread(Run).detach();
+}
+
+bool IsRunning()
+{
+  return s_running.load();
+}
+
+}
