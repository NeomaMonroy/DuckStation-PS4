+PS4KeyboardResult PS4Keyboard(std::string_view title, std::string_view initial, bool password, std::string* text)
+{
+  std::unique_lock lock(s_ps4_keyboard_mutex);
+  static bool s_loaded = false;
+  if (!s_loaded)
+  {
+    const int module = sceSysmoduleLoadModule(0x0096);
+    const int common = sceCommonDialogInitialize();
+    Log_InfoPrintf("IME dialog module %#x, common dialog %#x", static_cast<unsigned>(module),
+                   static_cast<unsigned>(common));
+    s_loaded = true;
+  }
+
+  constexpr u32 MAX_LENGTH = 128;
+  char16_t buffer[MAX_LENGTH + 1] = {};
+  const std::u16string initial16 = PS4ToUtf16(initial);
+  std::copy_n(initial16.begin(), std::min<size_t>(initial16.size(), MAX_LENGTH), buffer);
+  const std::u16string title16 = PS4ToUtf16(title);
+
+  int user_id = -1;
+  sceUserServiceGetInitialUser(&user_id);
+
+  PS4ImeDialogParam param = {};
+  param.user_id = user_id;
+  param.type = password ? 1 : 0;
+  param.option = password ? (0x4u | 0x2u | 0x20u) : (0x2u | 0x20u);
+  param.max_text_length = MAX_LENGTH;
+  param.input_text_buffer = buffer;
+  param.posx = 960.0f;
+  param.posy = 540.0f;
+  param.horizontal_alignment = 1;
+  param.vertical_alignment = 1;
+  param.title = title16.c_str();
+
+  const int init = sceImeDialogInit(&param, nullptr);
+  if (init < 0)
+  {
+    Log_ErrorPrintf("sceImeDialogInit() failed: %#x", static_cast<unsigned>(init));
+    return PS4KeyboardResult::Unavailable;
+  }
+
+  int status;
+  while ((status = sceImeDialogGetStatus()) == 1)
+    Common::Timer::NanoSleep(50 * 1000 * 1000);
+
+  PS4ImeDialogResult result = {};
+  const int got = sceImeDialogGetResult(&result);
+  sceImeDialogTerm();
+  if (got < 0 || result.end_status != 0)
+    return PS4KeyboardResult::Cancelled;
+
+  *text = PS4ToUtf8(buffer);
+  std::fill(std::begin(buffer), std::end(buffer), u'\0');
+  return PS4KeyboardResult::OK;
+}
+
+void PS4ShowLoginHelp()
+{
+  Host::RunOnCPUThread([]() {
+    ImGuiFullscreen::OpenInfoMessageDialog(
+      "RetroAchievements",
+      "The PS4 keyboard couldn't open. To log in instead, add these lines under [Cheevos] in "
+      "/data/DuckStation/settings.ini (over FTP), then start DuckStation again:\n\nUsername = your RetroAchievements name\n"
+      "Password = your password\n\nThe password is removed from the file after the login; only a login token is kept.");
+  });
+}
+
+void PS4DoLogin(std::string username, std::string password, bool from_settings)
+{
+  Error error;
+  const bool ok = Achievements::Login(username.c_str(), password.c_str(), &error);
+  std::fill(password.begin(), password.end(), '\0');
+  if (from_settings)
+  {
+    Host::DeleteBaseSettingValue("Cheevos", "Password");
+    Host::CommitBaseSettingChanges();
+  }
+  Log_InfoPrintf("RetroAchievements login for '%s': %s", username.c_str(),
+                 ok ? "ok" : error.GetDescription().c_str());
+  if (!ok)
+  {
+    Host::RunOnCPUThread([message = error.GetDescription()]() {
+      ImGuiFullscreen::ShowToast("RetroAchievements", "Login failed: " + message, 15.0f);
+    });
+  }
+}
+
+}
+
+static void PS4PasswordLogin(bool user_initiated)
+{
+  bool expected = false;
+  if (!s_ps4_login_running.compare_exchange_strong(expected, true))
+    return;
+
+  std::string username = Host::GetBaseStringSettingValue("Cheevos", "Username");
+  std::string password = Host::GetBaseStringSettingValue("Cheevos", "Password");
+  if (!username.empty() && !password.empty())
+  {
+    std::thread([username = std::move(username), password = std::move(password)]() mutable {
+      PS4DoLogin(std::move(username), std::move(password), true);
+      s_ps4_login_running.store(false);
+    }).detach();
+    return;
+  }
+
+  if (!user_initiated)
+  {
+    s_ps4_login_running.store(false);
+    return;
+  }
+
+  std::thread([username = std::move(username)]() mutable {
+    std::string typed_user, typed_password;
+    const PS4KeyboardResult user_result =
+      PS4Keyboard("RetroAchievements: user name", username, false, &typed_user);
+    if (user_result == PS4KeyboardResult::Unavailable)
+      PS4ShowLoginHelp();
+    if (user_result == PS4KeyboardResult::OK && !typed_user.empty())
+    {
+      const PS4KeyboardResult pass_result =
+        PS4Keyboard("RetroAchievements: password", "", true, &typed_password);
+      if (pass_result == PS4KeyboardResult::Unavailable)
+        PS4ShowLoginHelp();
+      if (pass_result == PS4KeyboardResult::OK && !typed_password.empty())
+        PS4DoLogin(std::move(typed_user), std::move(typed_password), false);
+    }
+    s_ps4_login_running.store(false);
+  }).detach();
+}
